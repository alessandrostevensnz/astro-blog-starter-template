---
import BaseHead from './BaseHead.astro';
import { responsivePhoto } from '../lib/optimized-images';
import { navigation, siteContent, pageContent, siteFooter } from '../data/site';
import { typographyCss } from '../lib/typography';
interface Props { title?: string; description?: string; }
const { title = 'ANDRO Construction + Projects — EST. 2020', description = 'Auckland construction, renovation, property maintenance and asset maintenance by ANDRO Construction + Projects.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<BaseHead title={title} description={description} />
<meta name="theme-color" content="#fbfaf7" />
<body>
  <style is:global set:html={typographyCss(siteContent.typography, { ...siteContent, projects: pageContent.projects, contact: pageContent.contact })} />
  <header class="site-header">
    <a class="brand-lockup" href="/" aria-label="ANDRO home">
      <span class="brand-word">ANDRO</span>
      <span class="brand-sub">Construction + Projects · Est. 2020</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="/contact/">Start a conversation </a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
    <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
      {navigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </header>
  {!/^\/win\/?$/.test(currentPath) && <div class="win-promo" id="win-promo" hidden>
    <a class="win-promo-link" href="/win" aria-label="Win a day on us. Free entry, mainland Auckland, terms apply.">
      <span class="win-promo-track" aria-hidden="true">
        {Array.from({length: 4}, () => <span class="win-promo-repeat"><strong>WIN A DAY <em>ON US.</em></strong><span>ANDRO CONSTRUCTION + PROJECTS</span><span>FREE ENTRY · AUCKLAND · CLOSES CHRISTMAS EVE · T&Cs APPLY</span><span>ENTER NOW</span></span>)}
      </span>
    </a>
    <button type="button" class="win-promo-pause" aria-label="Pause scrolling promotion">Ⅱ</button>
  </div>}
  <script is:inline>
    (() => {
      const promo = document.getElementById('win-promo');
      if (!promo) return;
      const close = Date.parse('2026-12-25T00:00:00+13:00');
      const refresh = () => { promo.hidden = Date.now() >= close; };
      refresh();
      setInterval(refresh, 30000);
      const button = promo.querySelector('button');
      button.addEventListener('click', () => {
        const paused = promo.classList.toggle('is-paused');
        button.textContent = paused ? '▶' : 'Ⅱ';
        button.setAttribute('aria-label', paused ? 'Resume scrolling promotion' : 'Pause scrolling promotion');
      });
    })();
  </script>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="footer-credentials" aria-label="ANDRO Construction logo">
      <img {...responsivePhoto(siteFooter.logo.src, '130px', 'small')} alt={siteFooter.logo.alt} loading="lazy" />
    </div>
    <p class="footer-company">{siteFooter.companyName}</p>
    <a class="footer-domain" href={siteFooter.domainUrl}>{siteFooter.domainText}</a>
    <p class="footer-established">{siteFooter.establishedText}</p>
    <a href="/website-privacy/" style="font-size:11px;color:#8e7547;text-decoration:underline">Website privacy &amp; analytics</a>
  </footer>
  <script is:inline src="/andro-analytics.js" defer></script>
  <script is:inline>
    // Only enabled inside the same-origin CMS iframe; no effect on public visitors.
    if (new URLSearchParams(location.search).has('androCmsPreview') && window.parent !== window) {
      window.addEventListener('message', function (event) {
        if (event.origin !== location.origin || event.source !== window.parent) return;
        if (!event.data || event.data.type !== 'andro-cms-preview') return;
        var fields = event.data.fields || {};
        Object.keys(fields).forEach(function (key) {
          if (!/^[a-zA-Z]+\.[a-zA-Z]+$/.test(key)) return;
          var target = document.querySelector('[data-style-key="' + key + '"]');
          if (target && typeof fields[key] === 'string') target.textContent = fields[key];
        });
      });
    }
  </script>
  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menuButton.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      if (mobileMenu) mobileMenu.hidden = open;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      mobileMenu.hidden = true;
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
    }));

    // All site header films share the same silent, inline autoplay behaviour.
    // Keep the photograph under each video as the fallback if Safari blocks playback.
    const backgroundVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-background-video]'));
    if (backgroundVideos.length) {
      const ensureBackgroundPlaying = (video: HTMLVideoElement) => {
        video.defaultMuted = true;
        video.muted = true;
        video.playsInline = true;
        video.autoplay = true;
        video.loop = true;
        video.controls = false;
        if (document.visibilityState !== 'visible' || !video.paused) return;
        void video.play().catch(() => {
          // A device may prohibit autoplay; there is no visible play control.
        });
      };
      const resumeBackgroundVideos = () => backgroundVideos.forEach(ensureBackgroundPlaying);
      backgroundVideos.forEach((video) => {
        video.addEventListener('canplay', () => ensureBackgroundPlaying(video));
        video.addEventListener('loadeddata', () => ensureBackgroundPlaying(video));
      });
      resumeBackgroundVideos();
      window.addEventListener('pageshow', resumeBackgroundVideos);
      document.addEventListener('visibilitychange', resumeBackgroundVideos);
    }
  </script>
</body>

<style is:global>
  .win-promo[hidden]{display:none!important}
  .win-promo{display:flex;align-items:stretch;background:#1e211f;color:#f7f4ec;height:76px;overflow:hidden;width:100%}
  .win-promo-link{display:flex;align-items:center;overflow:hidden;flex:1;min-width:0;color:inherit;text-decoration:none}
  .win-promo-track{display:flex;width:max-content;flex:none;animation:win-promo-scroll 48s linear infinite}
  .win-promo-repeat{display:flex;align-items:center;gap:38px;padding-right:38px;white-space:nowrap;font-size:11px;letter-spacing:.15em;color:#bda67e}
  .win-promo-repeat strong{font-family:Manrope,sans-serif;font-size:32px;font-weight:300;letter-spacing:-.045em;color:#f7f4ec}
  .win-promo-repeat em{font-family:Georgia,serif;color:#bda67e;font-weight:400}
  .win-promo-pause{background:transparent;color:#bda67e;border:0;border-left:1px solid #ffffff30;width:44px;flex:none;cursor:pointer}
  .win-promo.is-paused .win-promo-track{animation-play-state:paused}
  @keyframes win-promo-scroll{to{transform:translateX(-50%)}}
  @media(max-width:680px){.win-promo{height:60px}.win-promo-repeat strong{font-size:25px}.win-promo-repeat{gap:24px;padding-right:24px}}
  @media(prefers-reduced-motion:reduce){.win-promo-track{animation:none}.win-promo-pause{display:none}}

  /* Mirror the plain-text fields in /admin throughout all six pages.
     Return keeps a line break; a blank line keeps a paragraph gap.
     Scope this to editor-managed copy so navigation/layout whitespace
     and HTML forms continue behaving normally. Text remains escaped. */
  [data-style-key], [data-cms-text] {
    white-space: pre-wrap !important;
    overflow-wrap: break-word;
  }

  /* No native video controls or centre-play overlay on any ANDRO header film. */
  video[data-background-video]::-webkit-media-controls,
  video[data-background-video]::-webkit-media-controls-enclosure,
  video[data-background-video]::-webkit-media-controls-panel,
  video[data-background-video]::-webkit-media-controls-start-playback-button,
  video[data-background-video]::-webkit-media-controls-overlay-play-button {
    display: none !important;
    -webkit-appearance: none;
  }

  .brand-lockup {
    align-items: center;
    text-align: center;
  }

  .brand-word {
    font-size: clamp(29px, 2.5vw, 36px);
    letter-spacing: .3em;
  }

  .brand-sub {
    width: 100%;
    text-align: center;
    font-size: 8px;
    letter-spacing: .12em;
  }

  /* Improve readability and make navigation and actions easier to target. */
  body { font-size: 16px; }
  .desktop-nav a, .header-cta { font-size: 13px; }
  .desktop-nav a { padding: 14px 0; }
  .header-cta { padding: 12px 0; }
  .brand-sub { font-size: 10px; }
  .eyebrow { font-size: 11px; }
  .hero-subtitle, .intro-copy p, .body-copy { font-size: 16px; }
  .text-link { min-height: 44px; gap: 18px; font-size: 13px; }
  .card-meta p, .project-copy p { font-size: 13px; }
  .service-item > span:first-child, .service-item p { font-size: 14px; }
  .notice, .contact-details, .form-status { font-size: 14px; }
  .form-field label { font-size: 11px; }
  .form-submit { min-height: 48px; font-size: 13px; }
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 48px 24px 42px;
    text-align: center;
  }
  .footer-credentials { display: flex; align-items: center; justify-content: center; gap: 28px; width: 100%; margin-bottom: 12px; }
  .footer-credentials img { display: block; width: auto; height: 82px; max-width: 130px; object-fit: contain; }
  .footer-credentials img:first-child { height: 96px; max-width: 130px; }
  .footer-company, .footer-domain, .footer-established { margin: 0; color: #b19a6c; font-weight: 400; letter-spacing: .28em; text-transform: uppercase; }
  .footer-company { font-size: clamp(14px, 2vw, 20px); }
  .footer-domain { font-size: clamp(13px, 1.8vw, 18px); text-decoration: none; }
  .footer-established { font-size: 12px; letter-spacing: .38em; }
  .footer-domain:hover { color: #8e7547; }

  /* The site photos are supplied photos of ANDRO work; remove old stock-photo disclaimers. */
  .image-placeholder-note, .notice { display: none !important; }

  @media (max-width: 900px) {
    .desktop-nav a { font-size: 12px; }
  }
  @media (max-width: 680px) {
    .brand-word { font-size: 28px; }
    .brand-sub { font-size: 8px; }
    .mobile-nav a { min-height: 48px; font-size: 16px; }
    .hero-subtitle, .intro-copy p, .body-copy { font-size: 16px; }
    .page-hero .lead { font-size: 16px; }
    .service-item p { font-size: 14px; }
    .card-meta p, .project-copy p { font-size: 13px; }
    .site-footer { gap: 10px; padding: 38px 18px 34px; }
    .footer-credentials { gap: 18px; margin-bottom: 8px; }
    .footer-credentials img { height: 64px; max-width: 110px; }
    .footer-credentials img:first-child { height: 76px; max-width: 110px; }
    .footer-company { font-size: 13px; letter-spacing: .2em; }
  }
</style>
