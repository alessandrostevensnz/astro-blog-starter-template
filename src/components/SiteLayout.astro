---
import BaseHead from './BaseHead.astro';
import { navigation, site, siteContent, footerImagesForPath } from '../data/site';
import { typographyCss } from '../lib/typography';
interface Props { title?: string; description?: string; }
const { title = 'ANDRO Construction + Projects — EST. 2020', description = 'Auckland construction, renovation, property maintenance and asset maintenance by ANDRO Construction + Projects.' } = Astro.props;
const currentPath = Astro.url.pathname;
const footerImages = footerImagesForPath(currentPath);
---
<BaseHead title={title} description={description} />
<meta name="theme-color" content="#fbfaf7" />
<body>
  <style is:global set:html={typographyCss(siteContent.typography, siteContent)} />
  <header class="site-header">
    <a class="brand-lockup" href="/" aria-label="ANDRO home">
      <span class="brand-word">ANDRO</span>
      <span class="brand-sub">Construction + Projects · Est. 2020</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
    <nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
      {navigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="footer-credentials" aria-label="Company and safety credentials">
      <img src={footerImages.logo.src} alt={footerImages.logo.alt} loading="lazy" />
      <img src={footerImages.badge.src} alt={footerImages.badge.alt} loading="lazy" />
    </div>
    <p class="footer-company">{site.legalName}</p>
    <a class="footer-domain" href="https://andro.co.nz">ANDRO.CO.NZ</a>
    <p class="footer-established">EST. {site.established}</p>
  </footer>
  <script is:inline>
    // Only enabled inside the same-origin CMS iframe; no effect on public visitors.
    if (new URLSearchParams(location.search).has('androCmsPreview') && window.parent !== window) {
      window.addEventListener('message', function (event) {
        if (event.origin !== location.origin || event.source !== window.parent) return;
        if (!event.data || event.data.type !== 'andro-cms-preview') return;
        var fields = event.data.fields || {};
        Object.keys(fields).forEach(function (key) {
          if (!/^[a-zA-Z]+\.[a-zA-Z]+$/.test(key)) return;
          var target = document.querySelector('[data-style-key="' + key + '"]');
          if (target && typeof fields[key] === 'string') target.textContent = fields[key];
        });
      });
    }
  </script>
  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menuButton.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      if (mobileMenu) mobileMenu.hidden = open;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      mobileMenu.hidden = true;
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Open menu');
    }));
  </script>
</body>

<style is:global>
  .brand-lockup {
    align-items: center;
    text-align: center;
  }

  .brand-word {
    font-size: clamp(29px, 2.5vw, 36px);
    letter-spacing: .3em;
  }

  .brand-sub {
    width: 100%;
    text-align: center;
    font-size: 8px;
    letter-spacing: .12em;
  }

  /* Improve readability and make navigation and actions easier to target. */
  body { font-size: 16px; }
  .desktop-nav a, .header-cta { font-size: 13px; }
  .desktop-nav a { padding: 14px 0; }
  .header-cta { padding: 12px 0; }
  .brand-sub { font-size: 10px; }
  .eyebrow { font-size: 11px; }
  .hero-subtitle, .intro-copy p, .body-copy { font-size: 16px; }
  .text-link { min-height: 44px; gap: 18px; font-size: 13px; }
  .card-meta p, .project-copy p { font-size: 13px; }
  .service-item > span:first-child, .service-item p { font-size: 14px; }
  .notice, .contact-details, .form-status { font-size: 14px; }
  .form-field label { font-size: 11px; }
  .form-submit { min-height: 48px; font-size: 13px; }
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 48px 24px 42px;
    text-align: center;
  }
  .footer-credentials { display: flex; align-items: center; justify-content: center; gap: 28px; width: 100%; margin-bottom: 12px; }
  .footer-credentials img { display: block; width: auto; height: 82px; max-width: 130px; object-fit: contain; }
  .footer-credentials img:first-child { height: 96px; }
  .footer-company, .footer-domain, .footer-established { margin: 0; color: #b19a6c; font-weight: 400; letter-spacing: .28em; text-transform: uppercase; }
  .footer-company { font-size: clamp(14px, 2vw, 20px); }
  .footer-domain { font-size: clamp(13px, 1.8vw, 18px); text-decoration: none; }
  .footer-established { font-size: 12px; letter-spacing: .38em; }
  .footer-domain:hover { color: #8e7547; }

  /* The site photos are supplied photos of ANDRO work; remove old stock-photo disclaimers. */
  .image-placeholder-note, .notice { display: none !important; }

  @media (max-width: 900px) {
    .desktop-nav a { font-size: 12px; }
  }
  @media (max-width: 680px) {
    .brand-word { font-size: 28px; }
    .brand-sub { font-size: 8px; }
    .mobile-nav a { min-height: 48px; font-size: 16px; }
    .hero-subtitle, .intro-copy p, .body-copy { font-size: 16px; }
    .page-hero .lead { font-size: 16px; }
    .service-item p { font-size: 14px; }
    .card-meta p, .project-copy p { font-size: 13px; }
    .site-footer { gap: 10px; padding: 38px 18px 34px; }
    .footer-credentials { gap: 18px; margin-bottom: 8px; }
    .footer-credentials img { height: 64px; max-width: 110px; }
    .footer-credentials img:first-child { height: 76px; }
    .footer-company { font-size: 13px; letter-spacing: .2em; }
  }
</style>
