---
import SiteLayout from '../components/SiteLayout.astro';
import { site, imagery } from '../data/site';
---
<SiteLayout title="About ANDRO — Construction + Projects" description="Learn about ANDRO Construction + Projects, an Auckland company established in 2020.">
  <section class="page-hero about-hero"><p class="eyebrow">ABOUT ANDRO · EST. {site.established}</p><h1>Built on care.<br />Grounded in craft.</h1><p class="lead">ANDRO Construction + Projects is an Auckland-based construction company focused on thoughtful work, quality craftsmanship and dependable service.</p></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">WHO WE ARE</p><h2>Good people.<br />Good work.</h2></div><div><p class="body-copy">We work with residential and commercial clients across construction, renovations and property maintenance. Every project starts with listening: understanding the brief, the space and what a good result means to you.</p><p class="body-copy">From the first conversation to the finishing details, we aim to make the process clear and considered—combining practical thinking with care in the workmanship.</p></div></div></section>
  <section class="image-band"><img src={imagery.exterior.src} alt={imagery.exterior.alt} loading="lazy" /><span class="image-placeholder-note">Illustrative image · not an ANDRO project</span><div class="image-band-copy"><p class="eyebrow inverse">THE ANDRO APPROACH</p><h2>Craftsmanship, quality and service.</h2></div></section>
  <section class="cta-section"><div class="cta-row"><h2>Let’s talk<br />about your project.</h2><a class="text-link" href="/contact/">Contact ANDRO <span>↗</span></a></div></section>
</SiteLayout>

<style>
  .about-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #555;
  }
  .about-hero::before, .about-hero::after { position: absolute; inset: 0; content: ''; }
  .about-hero::before {
    z-index: -2;
    background: url('/images/Bright%20Wainscoted%20Hallway%20with%20Open%20Door.png') center 48% / cover no-repeat;
  }
  .about-hero::after { z-index: -1; background: linear-gradient(90deg, rgba(20, 20, 18, .58), rgba(20, 20, 18, .12) 90%); }
  .about-hero .eyebrow, .about-hero h1, .about-hero .lead { color: #fff; }
</style>
