---
import SiteLayout from '../components/SiteLayout.astro';
import { site, siteContent } from '../data/site';
const photos = siteContent.about.photos;
---
<SiteLayout title="About ANDRO | Construction Company Auckland" description={siteContent.about.description}>
  <section class="page-hero about-hero"><img class="about-hero-image" src={photos.hero.src} alt={photos.hero.alt} fetchpriority="high" /><p class="eyebrow inverse">ABOUT ANDRO · EST. {site.established}</p><h1>Built on care.<br />Grounded in craft.</h1><p class="lead">{siteContent.about.heroIntro}</p></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">WHO WE ARE</p><h2><span data-style-key="about.whoHeading">{siteContent.about.whoHeading}</span></h2></div><div><p class="body-copy"><span data-style-key="about.whoText">{siteContent.about.whoText}</span></p><p class="body-copy">{siteContent.about.craftText}</p></div></div></section>
  <section class="image-band"><img src={photos.approach.src} alt={photos.approach.alt} loading="lazy" /><div class="image-band-copy"><p class="eyebrow inverse">OUR APPROACH</p><h2>{siteContent.about.craftHeading}</h2></div></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">LOOKING AHEAD</p><h2>{siteContent.about.visionHeading}</h2></div><div><p class="body-copy">{siteContent.about.visionText}</p><p class="body-copy">The principles behind ANDRO reflect a simple belief: the industry needs more care in its workmanship and more attention to the service people receive. We want that belief to be visible in the way we handle each conversation and each piece of work.</p><a class="text-link" href="/contact/">Get in touch with ANDRO <span>↗</span></a></div></div></section>
</SiteLayout>
<style>
.about-hero{position:relative;isolation:isolate;overflow:hidden;color:#fff;background:#555}.about-hero-image,.about-hero::after{position:absolute;inset:0}.about-hero-image{z-index:-2;width:100%;height:100%;object-fit:cover;object-position:center 48%}.about-hero::after{content:'';z-index:-1;background:linear-gradient(90deg,rgba(20,20,18,.58),rgba(20,20,18,.12) 90%)}.about-hero .eyebrow,.about-hero h1,.about-hero .lead{color:#fff}
</style>
