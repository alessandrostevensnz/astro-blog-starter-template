---
import SiteLayout from '../components/SiteLayout.astro';
import { site, imagery, siteContent } from '../data/site';
---
<SiteLayout title="About ANDRO | Construction Company Auckland" description={siteContent.about.description}>
  <section class="page-hero about-hero"><p class="eyebrow inverse">ABOUT ANDRO · EST. {site.established}</p><h1>Built on care.<br />Grounded in craft.</h1><p class="lead">{siteContent.about.heroIntro}</p></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">WHO WE ARE</p><h2>{siteContent.about.whoHeading}</h2></div><div><p class="body-copy">{siteContent.about.whoText}</p><p class="body-copy">{siteContent.about.craftText}</p></div></div></section>
  <section class="image-band"><img src="/ranchslider%20framing.png" alt="Ranch slider framing work" loading="lazy" /><div class="image-band-copy"><p class="eyebrow inverse">OUR APPROACH</p><h2>{siteContent.about.craftHeading}</h2></div></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">LOOKING AHEAD</p><h2>{siteContent.about.visionHeading}</h2></div><div><p class="body-copy">{siteContent.about.visionText}</p><p class="body-copy">The principles behind ANDRO reflect a simple belief: the industry needs more care in its workmanship and more attention to the service people receive. We want that belief to be visible in the way we handle each conversation and each piece of work.</p><a class="text-link" href="/contact/">Get in touch with ANDRO <span>↗</span></a></div></div></section>
  <section class="cta-section"><div class="cta-row"><h2>Let’s talk<br />about your property.</h2><a class="text-link" href="/contact/">Contact ANDRO <span>↗</span></a></div></section>
</SiteLayout>
<style>
.about-hero{position:relative;isolation:isolate;overflow:hidden;color:#fff;background:#555}.about-hero::before,.about-hero::after{position:absolute;inset:0;content:''}.about-hero::before{z-index:-2;background:url('/images/Bright%20Wainscoted%20Hallway%20with%20Open%20Door.png') center 48%/cover no-repeat}.about-hero::after{z-index:-1;background:linear-gradient(90deg,rgba(20,20,18,.58),rgba(20,20,18,.12) 90%)}.about-hero .eyebrow,.about-hero h1,.about-hero .lead{color:#fff}
</style>
