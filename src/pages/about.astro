---
import SiteLayout from '../components/SiteLayout.astro';
import { site, imagery } from '../data/site';
---
<SiteLayout title="About ANDRO — Construction + Projects" description="Learn about ANDRO Construction + Projects, an Auckland company established in 2020.">
  <section class="page-hero"><p class="eyebrow">ABOUT ANDRO · EST. {site.established}</p><h1>Built on care.<br />Grounded in craft.</h1><p class="lead">ANDRO Construction + Projects is an Auckland-based construction and property services company established in 2020.</p></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">WHO WE ARE</p><h2>Good people.<br />Good work.</h2></div><div><p class="body-copy">We work with residential and commercial clients across construction, renovations, property maintenance and asset maintenance. We believe every project deserves a considered plan, careful workmanship and clear communication.</p><p class="body-copy">As Andro Construction Limited, we aim to make the process straightforward—from understanding the brief and coordinating the work to completing the details with care.</p><p class="body-copy">We are based in Auckland, New Zealand. Get in touch to discuss your project or property needs.</p></div></div><div class="fact-row"><div class="fact"><strong>EST. {site.established}</strong><span>Established</span></div><div class="fact"><strong>Auckland</strong><span>New Zealand</span></div><div class="fact"><strong>ANDRO</strong><span>Construction + Projects</span></div></div></section>
  <section class="image-band"><img src={imagery.exterior.src} alt={imagery.exterior.alt} loading="lazy" /><span class="image-placeholder-note">Illustrative image · not an ANDRO project</span><div class="image-band-copy"><p class="eyebrow inverse">OUR PRINCIPLES</p><h2>Care in every<br />consideration.</h2></div></section>
  <section class="cta-section"><div class="cta-row"><h2>Let’s talk<br />about your project.</h2><a class="text-link" href="/contact/">Contact ANDRO <span>↗</span></a></div></section>
</SiteLayout>
