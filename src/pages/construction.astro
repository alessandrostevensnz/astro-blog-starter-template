---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent } from '../data/site';
import optimizedGallery from '../data/project-gallery-optimized.generated.json';

const photos = siteContent.construction.photos;
const constructionHeroVideo = siteContent.construction.heroVideo?.trim() || '';
const galleryThumbs = optimizedGallery as Record<string, { small: string; large: string }>;
// The Construction showcase uses the SAME ordered photos as /projects/ and /admin.
const projects = siteContent.projects.filter((project) => typeof project.image === 'string' && project.image.length > 0);
const slideshowDuration = Math.max(50, projects.length * 3.6);
---
<SiteLayout title="Construction, Carpentry & Renovations Auckland | ANDRO" description={siteContent.construction.description}>
  <section class="construction-hero" aria-labelledby="construction-title">
    <img class="construction-hero-image" src={photos.hero.src} alt={photos.hero.alt} fetchpriority="high" />
    {constructionHeroVideo && (
      <video class="construction-hero-video" autoplay muted loop playsinline webkit-playsinline preload="auto"
        poster={photos.hero.src} aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback>
        <source src={constructionHeroVideo} type="video/mp4" />
      </video>
    )}
    <div class="construction-hero-shade" aria-hidden="true"></div>
    <div class="construction-hero-copy">
      <p class="eyebrow inverse">CONSTRUCTION · AUCKLAND</p>
      <h1 id="construction-title">Built with<br />purpose.</h1>
      <p class="lead">{siteContent.construction.description}</p>
    </div>
  </section>

  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">CONSTRUCTION + RENOVATIONS</p><h2><span data-style-key="construction.introHeading">{siteContent.construction.introHeading}</span></h2></div><div><p class="body-copy"><span data-style-key="construction.introText">{siteContent.construction.introText}</span></p><p class="body-copy">Preparation matters because details that are missed early can affect access, sequencing, material choices and the finished result. We aim to discuss those practicalities before work gets underway.</p><a class="text-link" href="/contact/">Discuss your project </a></div></div></section>

  <section class="construction-hero construction-section-hero construction-residential-hero" aria-labelledby="residential-construction-title">
    <img class="construction-hero-image" src={photos.residential.src} alt={photos.residential.alt} loading="lazy" decoding="async" />
    <div class="construction-hero-shade" aria-hidden="true"></div>
    <div class="construction-hero-copy">
      <p class="eyebrow inverse">RESIDENTIAL CONSTRUCTION</p>
      <h2 id="residential-construction-title">{siteContent.construction.residentialHeading}</h2>
      <a class="construction-section-hero-link" href="/contact/">Discuss a residential project </a>
    </div>
  </section>

  <section class="content-block residential-services" aria-label="Residential construction services">
    <p class="body-copy construction-services-intro">{siteContent.construction.residentialText}</p>
    <div class="service-list construction-service-list">
      <article class="service-item">
        <span>01</span>
        <h3>General carpentry</h3>
        <p>Careful carpentry for practical changes, repairs and improvements, with attention to how new work connects to the existing building.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceCarpentry.src]?.small ?? photos.serviceCarpentry.src} alt={photos.serviceCarpentry.alt} loading="lazy" decoding="async" />
      </article>
      <article class="service-item">
        <span>02</span>
        <h3>Decks and fencing</h3>
        <p>Decking and fence work planned around the site, intended use, material exposure and the details that affect durability and everyday function.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceDecks.src]?.small ?? photos.serviceDecks.src} alt={photos.serviceDecks.alt} loading="lazy" decoding="async" />
      </article>
      <article class="service-item">
        <span>03</span>
        <h3>Renovations and alterations</h3>
        <p>Thoughtful improvements to existing spaces, balancing appearance, function and the realities of working with an existing structure.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceRenovations.src]?.small ?? photos.serviceRenovations.src} alt={photos.serviceRenovations.alt} loading="lazy" decoding="async" />
      </article>
    </div>
  </section>

  <section class="construction-hero construction-section-hero construction-commercial-hero" aria-labelledby="commercial-construction-title">
    <img class="construction-hero-image" src={photos.commercial.src} alt={photos.commercial.alt} loading="lazy" decoding="async" />
    <div class="construction-hero-shade" aria-hidden="true"></div>
    <div class="construction-hero-copy">
      <p class="eyebrow inverse">COMMERCIAL CONSTRUCTION</p>
      <h2 id="commercial-construction-title">{siteContent.construction.commercialHeading}</h2>
      <a class="construction-section-hero-link" href="/contact/">Talk through a commercial brief </a>
    </div>
  </section>

  <section class="content-block commercial-services" aria-label="Commercial construction services">
    <p class="body-copy construction-services-intro">{siteContent.construction.commercialText}</p>
    <div class="service-list construction-service-list">
      <article class="service-item">
        <span>01</span>
        <h3>Commercial carpentry and repairs</h3>
        <p>Carpentry, detailed improvements and practical repairs for commercial properties, with attention to workmanship and the people using the space.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceCommercialCarpentry.src]?.small ?? photos.serviceCommercialCarpentry.src} alt={photos.serviceCommercialCarpentry.alt} loading="lazy" decoding="async" />
      </article>
      <article class="service-item">
        <span>02</span>
        <h3>Fit-outs and interior improvements</h3>
        <p>Interior framing, fit-outs and alterations planned around how offices, retail and hospitality spaces need to function.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceCommercialFitouts.src]?.small ?? photos.serviceCommercialFitouts.src} alt={photos.serviceCommercialFitouts.alt} loading="lazy" decoding="async" />
      </article>
      <article class="service-item">
        <span>03</span>
        <h3>Alterations and refurbishments</h3>
        <p>Upgrades, recladding and refurbishment work coordinated around access, sequencing and keeping disruption to a minimum.</p>
        <img class="construction-service-photo" src={galleryThumbs[photos.serviceCommercialRefurbishment.src]?.small ?? photos.serviceCommercialRefurbishment.src} alt={photos.serviceCommercialRefurbishment.alt} loading="lazy" decoding="async" />
      </article>
    </div>
  </section>

  <section class="content-block"><p class="eyebrow">A CONSIDERED PROCESS</p><h2>{siteContent.construction.processHeading}</h2><p class="body-copy construction-copy">{siteContent.construction.processText}</p><div class="editorial-grid construction-process-photos"><div class="editorial-image"><img src={photos.processLeft.src} alt={photos.processLeft.alt} loading="lazy" decoding="async" /></div><div class="editorial-image"><img src={photos.processRight.src} alt={photos.processRight.alt} loading="lazy" decoding="async" /></div></div></section>

  <section class="construction-showcase" aria-labelledby="construction-showcase-title">
    <div class="construction-showcase-top">
      <header class="construction-showcase-heading">
        <p class="eyebrow">PROJECT SHOWCASE · AUCKLAND</p>
        <h2 id="construction-showcase-title">Our Work.<br />In the Details.</h2>
        <p>A moving selection of photographs from our projects across Auckland. Explore the full gallery for more of our construction, renovation and improvement work.</p>
      </header>
      <div class="construction-showcase-actions">
        <a class="text-link" href="/projects/">Explore all projects </a>
      </div>
    </div>
    {projects.length > 0 ? (
      <div class="construction-photo-reel" data-showcase-reel role="region" aria-label="Automatically scrolling project photographs">
        <div class="construction-photo-track" style={`--gallery-loop-duration: ${slideshowDuration}s;`}>
          {[0, 1].map((copy) => (
            <div class="construction-photo-sequence" aria-hidden={copy === 1 ? 'true' : undefined}>
              {projects.map((project, index) => (
                <figure class="construction-photo-item">
                  <img
                    src={galleryThumbs[project.image]?.large ?? project.image}
                    srcset={galleryThumbs[project.image] ? `${galleryThumbs[project.image].small} 480w, ${galleryThumbs[project.image].large} 960w` : undefined}
                    sizes="(max-width: 680px) 78vw, (max-width: 900px) 42vw, 345px"
                    alt={copy === 0 ? (project.alt || project.title) : ''}
                    loading={copy === 0 && index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <figcaption>
                    <span class="construction-photo-category">{project.category}</span>
                    <span class="construction-photo-title">{project.title}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    ) : (
      <p class="construction-showcase-empty">Project photographs will appear here once they are added in <a href="/admin/">the Projects editor</a>.</p>
    )}
  </section>

  <section class="cta-section"><div class="cta-row"><h2>Tell us what<br />you’re planning.</h2><a class="text-link" href="/contact/">Start a conversation </a></div></section>
</SiteLayout>

<script>
  const constructionVideo = document.querySelector<HTMLVideoElement>('.construction-hero-video');
  if (constructionVideo) {
    // iPhone Safari needs an inline, muted video for autoplay. No user controls.
    constructionVideo.defaultMuted = true;
    constructionVideo.muted = true;
    constructionVideo.playsInline = true;
    constructionVideo.removeAttribute('controls');

    const ensurePlaying = () => {
      if (document.visibilityState === 'hidden' || !constructionVideo.paused) return;
      constructionVideo.play().catch(() => {
        // Device-level autoplay restrictions may apply; the hero photo remains visible.
      });
    };

    ensurePlaying();
    constructionVideo.addEventListener('canplay', ensurePlaying);
    window.addEventListener('pageshow', ensurePlaying);
    document.addEventListener('visibilitychange', ensurePlaying);
  }
</script>

<style>
.construction-hero{min-height:max(580px,min(720px,calc(100svh - 82px)));position:relative;display:flex;align-items:center;overflow:hidden;isolation:isolate;padding:clamp(80px,12vw,150px) 10%;color:#fff;background:#77766f}.construction-hero-image,.construction-hero-shade{position:absolute;inset:0;width:100%;height:100%}.construction-hero-image{z-index:-2;object-fit:cover;object-position:center 48%}.construction-hero-shade{z-index:-1;background:linear-gradient(90deg,rgba(15,16,14,.62),rgba(15,16,14,.12) 85%),linear-gradient(0deg,rgba(15,16,14,.22),transparent 55%)}.construction-hero-copy{max-width:900px}.construction-hero h1{margin:22px 0 25px;color:#fff;font-family:var(--font-display);font-size:clamp(68px,10vw,136px);font-weight:300;line-height:.92;letter-spacing:-.085em}.construction-hero .lead{max-width:700px;margin:0;color:rgba(255,255,255,.92);font-size:16px;line-height:1.85}.construction-copy{max-width:850px;margin:0 0 32px}.content-block .service-list{margin-top:32px}
/* Native video replaces the main still photo while preserving its existing overlay and caption. */
.construction-hero-video {
  position: absolute; inset: 0; z-index: -1;
  display: block; width: 100%; height: 100%;
  object-fit: cover; object-position: center 48%;
  pointer-events: none;
}
/* Suppress iOS/Safari's native centre-play overlay and transport UI. */
:global(.construction-hero-video::-webkit-media-controls),
:global(.construction-hero-video::-webkit-media-controls-panel),
:global(.construction-hero-video::-webkit-media-controls-start-playback-button),
:global(.construction-hero-video::-webkit-media-controls-overlay-play-button) {
  display: none !important;
  -webkit-appearance: none;
}
.construction-hero:not(.construction-section-hero) .construction-hero-shade {
  z-index: 0;
  pointer-events: none;
}
.construction-hero:not(.construction-section-hero) .construction-hero-copy {
  position: relative;
  z-index: 1;
}
/* Matching photo-led residential and commercial section headers. */
.construction-hero.construction-section-hero {
  min-height: clamp(375px, 38vw, 470px);
  padding: clamp(70px, 7.5vw, 96px) 10%;
}
.construction-section-hero .construction-hero-image { object-position: center 45%; }
.construction-residential-hero .construction-hero-image { object-position: center 51%; }
.construction-section-hero .construction-hero-shade {
  background: linear-gradient(90deg, rgba(15,16,14,.79) 0%, rgba(15,16,14,.55) 46%, rgba(15,16,14,.18) 100%), linear-gradient(0deg,rgba(15,16,14,.30),transparent 62%);
}
.construction-section-hero .construction-hero-copy { max-width: 780px; }
.construction-section-hero h2 {
  max-width: 780px;
  margin: 22px 0 22px;
  color: #fff;
  font-family: var(--font-display);
  font-size: clamp(46px,6.6vw,88px);
  font-weight: 300;
  line-height: .96;
  letter-spacing: -.075em;
}
.construction-residential-hero .construction-hero-copy { max-width: 880px; }
.construction-section-hero-link {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  margin-top: 18px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--brand-accent-soft);
  color: #fff;
  font-size: 12px;
  text-decoration: none;
  transition: border-color .2s ease;
}
.construction-section-hero-link:hover { border-bottom-color: #fff; }
.construction-section-hero-link:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
.construction-section-hero-link span { color: var(--brand-accent-soft); }
@media (max-width: 680px) {
  .construction-hero.construction-section-hero { min-height: 0; padding: 76px 7% 84px; }
  .construction-section-hero .construction-hero-image { object-position: 55% center; }
  .construction-section-hero h2 { font-size: clamp(43px,10vw,63px); }
}

/* Keep the two process photographs as a compact paired feature, not large page breaks. */
.construction-process-photos { width: 100%; max-width: 1000px; margin-top: 28px; gap: 16px; }
.construction-process-photos .editorial-image { aspect-ratio: 1.7 / 1; }
@media (max-width: 680px) {
  .construction-process-photos { gap: 10px; margin-top: 24px; }
  .construction-process-photos .editorial-image { aspect-ratio: 1.25 / 1; }
}
/* Show section descriptions on the light background immediately above the related work examples. */
.construction-services-intro {
  max-width: 830px;
  margin: 0 0 clamp(32px, 4vw, 50px);
  font-size: clamp(13px, 1.05vw, 15px);
  line-height: 1.9;
}
@media (max-width: 680px) {
  .construction-services-intro { margin-bottom: 30px; line-height: 1.85; }
}

/* Matching compact right-hand photographs for residential and commercial service rows. */
.construction-service-list .service-item {
  grid-template-columns: clamp(50px,5vw,70px) minmax(0,1fr) clamp(140px,13vw,205px);
  column-gap: clamp(12px,1.6vw,23px);
  row-gap: 8px;
  align-items: start;
  padding: 20px 0;
}
.construction-service-list .service-item > span:first-child { grid-column: 1; grid-row: 1; padding-top: 6px; }
.construction-service-list .service-item h3 { grid-column: 2; grid-row: 1; min-width: 0; }
.construction-service-list .service-item p { grid-column: 2; grid-row: 2; margin: 0; max-width: 760px; }
.construction-service-list .construction-service-photo {
  grid-column: 3;
  grid-row: 1 / span 2;
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  background: #d4d0c8;
}
@media (max-width: 680px) {
  .construction-service-list .service-item {
    grid-template-columns: 26px minmax(0,1fr) clamp(78px,23vw,110px);
    gap: 7px 10px;
    padding: 17px 0;
  }
  .construction-service-list .service-item h3 { font-size: clamp(18px,4.5vw,23px); }
  .construction-service-list .service-item p { font-size: 12px; }
  .construction-service-list .construction-service-photo { grid-column: 3; grid-row: 1 / span 2; }
}

/* Keep the new commercial rows close to their photographic banner. */
.commercial-services { padding-top: clamp(42px,5vw,74px); padding-bottom: clamp(42px,5vw,66px); }
.commercial-services .construction-service-list { margin-top: 0; }

.construction-showcase { padding: 100px 10% 110px; background: var(--brand-paper); overflow: hidden; }
.construction-showcase-top { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 36px; }
.construction-showcase-heading { max-width: 700px; }
.construction-showcase-heading h2 { margin: 16px 0 22px; font-family: var(--font-display); font-size: clamp(48px,7vw,88px); font-weight: 300; line-height: .98; letter-spacing: -.075em; }
.construction-showcase-heading>p:last-child { max-width: 650px; margin: 0; color: var(--brand-muted); font-size: 16px; line-height: 1.9; }
.construction-showcase-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; flex: 0 0 auto; padding-bottom: 8px; }
.construction-showcase-actions .text-link { white-space: nowrap; }
.construction-photo-reel { width: 100%; overflow: hidden; }
.construction-photo-track { display: flex; width: max-content; animation: andro-project-loop var(--gallery-loop-duration, 125s) linear infinite; will-change: transform; }
.construction-photo-sequence { display: flex; flex: 0 0 auto; gap: 16px; padding-right: 16px; }
.construction-photo-item { position: relative; flex: 0 0 clamp(235px,24vw,345px); width: clamp(235px,24vw,345px); aspect-ratio: 4/3; margin: 0; overflow: hidden; background: #d4d0c8; }
.construction-photo-item img { display: block; width: 100%; height: 100%; object-fit: cover; }
.construction-photo-item figcaption { display: flex; flex-direction: column; justify-content: end; gap: 6px; position: absolute; inset: 0; padding: 18px; background: linear-gradient(to top,rgba(10,12,11,.78),rgba(10,12,11,0) 58%); color: #fff; }
.construction-photo-category { color: #dfcba7; font-size: 10px; letter-spacing: .08em; line-height: 1.3; text-transform: uppercase; }
.construction-photo-title { font-family: var(--font-display); font-size: clamp(18px,1.7vw,23px); line-height: 1.15; }
.construction-showcase-empty { color: var(--brand-muted); font-size: 14px; }
.construction-showcase-empty a { text-decoration: underline; }
@media (hover: hover) { .construction-photo-reel:hover .construction-photo-track { animation-play-state: paused; } }
@keyframes andro-project-loop { to { transform: translate3d(-50%,0,0); } }
@media (max-width: 900px) {
  .construction-showcase { padding-right: 7%; padding-left: 7%; }
  .construction-photo-item { flex-basis: clamp(230px,42vw,320px); width: clamp(230px,42vw,320px); }
}
@media (max-width: 680px) {
  .construction-hero { min-height: 590px; padding: 76px 7%; }
  .construction-hero-image { object-position: 58% center; }
  .construction-hero h1 { font-size: clamp(62px,14vw,92px); }
  .construction-showcase { padding: 68px 7% 76px; }
  .construction-showcase-top { flex-direction: column; align-items: flex-start; gap: 20px; }
  .construction-showcase-heading h2 { font-size: clamp(48px,10vw,70px); }
  .construction-showcase-heading>p:last-child { font-size: 13px; line-height: 1.75; }
  .construction-showcase-actions { flex-direction: row; gap: 24px; flex-wrap: wrap; }
  .construction-photo-item { flex-basis: min(78vw,320px); width: min(78vw,320px); }
  .construction-photo-item figcaption { padding: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  .construction-photo-track { animation: none !important; }
  .construction-photo-reel { overflow-x: auto; scroll-snap-type: x proximity; }
  .construction-photo-item { scroll-snap-align: start; }
}
</style>
