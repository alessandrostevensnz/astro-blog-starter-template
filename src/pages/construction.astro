---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery } from '../data/site';
---
<SiteLayout title="Construction + Renovations — ANDRO" description="Residential and commercial construction and renovation services in Auckland from ANDRO Construction + Projects.">
  <section class="page-hero">
    <p class="eyebrow">CONSTRUCTION · AUCKLAND</p>
    <h1>Built with<br />purpose.</h1>
    <p class="lead">Residential and commercial construction and renovations, planned carefully and carried out with a focus on quality and clear communication.</p>
  </section>

  <section class="image-band" aria-label="Residential framing project">
    <img src="/images/Residential%20framing.png" alt="Residential framing during construction" fetchpriority="high" />
  </section>

  <section class="page-body section-pad">
    <div class="two-col">
      <div>
        <p class="eyebrow">CONSTRUCTION + RENOVATIONS</p>
        <h2>From the first<br />conversation onward.</h2>
      </div>
      <div>
        <p class="body-copy">ANDRO Construction + Projects works with clients on construction and renovation projects in Auckland. We take time to understand the requirements, consider the practical details and coordinate the work through delivery.</p>
        <p class="body-copy">Every project is different. Contact us with your brief to discuss scope, timing and the right next steps.</p>
        <a class="text-link" href="/contact/">Discuss your project <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="content-block">
    <p class="eyebrow">AREAS OF WORK</p>
    <h2>Construction support shaped around your brief.</h2>
    <div class="service-list">
      <article class="service-item"><span>01</span><h3>Residential construction</h3><b>↗</b><p>Construction work for residential clients, planned around the site, scope and intended outcome.</p></article>
      <article class="service-item"><span>02</span><h3>Commercial construction</h3><b>↗</b><p>Construction support for commercial spaces and property requirements.</p></article>
      <article class="service-item"><span>03</span><h3>Renovations</h3><b>↗</b><p>Renovation work to improve, adapt or refresh existing spaces.</p></article>
    </div>
  </section>

  <section class="page-body section-pad">
    <div class="editorial-grid">
      <div class="editorial-image"><img src={imagery.construction.src} alt={imagery.construction.alt} loading="lazy" /></div>
      <div class="editorial-image"><img src={imagery.home.src} alt={imagery.home.alt} loading="lazy" /></div>
    </div>
    <p class="notice">Project photographs show examples of construction work and are provided for illustrative purposes.</p>
  </section>

  <section class="cta-section"><div class="cta-row"><h2>Tell us what<br />you’re planning.</h2><a class="text-link" href="/contact/">Start a conversation <span>↗</span></a></div></section>
</SiteLayout>
