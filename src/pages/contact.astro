---
import SiteLayout from '../components/SiteLayout.astro';
import { site } from '../data/site';
---
<SiteLayout title="Contact ANDRO — Construction + Projects" description="Contact ANDRO Construction + Projects in Auckland, New Zealand to discuss construction, renovation and maintenance needs.">
  <section class="page-hero">
    <p class="eyebrow">CONTACT · AUCKLAND, NEW ZEALAND</p>
    <h1>Let’s make a<br />good start.</h1>
    <p class="lead">Tell us a little about your project or property needs. We’ll be in touch to discuss the next steps.</p>
  </section>
  <section class="page-body section-pad">
    <div class="contact-layout">
      <div>
        <p class="eyebrow">ANDRO CONSTRUCTION + PROJECTS</p>
        <h2 class="display-heading">A considered<br />conversation.</h2>
        <p class="body-copy">Share a few details about your project and the ANDRO team will follow up with you.</p>
        {site.email && <p class="contact-details">Or email us at <a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </div>
      <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="475ddde6-2a40-4c0a-80d8-3d5ecb6d90f5" />
        <input type="hidden" name="subject" value="New enquiry from the ANDRO website" />
        <input type="hidden" name="from_name" value="ANDRO website contact form" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="form-field full"><label for="service">What can we help with?</label><select id="service" name="service" required><option value="" disabled selected>Select a service</option><option>Residential construction</option><option>Commercial construction</option><option>Renovation</option><option>Property or asset maintenance</option><option>Other</option></select></div>
        <div class="form-field full"><label for="message">A little about your project</label><textarea id="message" name="message" required></textarea></div>
        <button class="form-submit" type="submit">Send enquiry ↗</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite">Your details will be sent securely to ANDRO.</p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !status || !submitButton) return;

      const originalLabel = submitButton.textContent;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      status.textContent = 'Sending your enquiry…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || 'The form could not be sent.');
        status.textContent = 'Thanks — your enquiry has been sent. ANDRO will be in touch.';
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error
          ? `${error.message} Please try again or email ANDRO directly.`
          : 'Sorry, your enquiry could not be sent. Please try again or email ANDRO directly.';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = originalLabel || 'Send enquiry ↗';
      }
    });
  </script>
</SiteLayout>

<style>
  .hidden { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { min-height: 1.6em; }
  .form-submit:disabled { opacity: .65; cursor: wait; }
</style>
