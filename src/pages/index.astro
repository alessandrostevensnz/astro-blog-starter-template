---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en-NZ">
	<head>
		<BaseHead
			title="ANDRO — Built for living"
			description="ANDRO is a New Zealand construction and projects company, creating considered places with care, craft and purpose."
		/>
		<meta name="theme-color" content="#f3f1ec" />
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="#home" aria-label="ANDRO home">ANDRO</a>
			<nav class="desktop-nav" aria-label="Main navigation">
				<a href="#projects">Projects</a>
				<a href="#approach">Our approach</a>
				<a href="#studio">About</a>
			</nav>
			<a class="header-cta" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
			<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span><span></span>
			</button>
			<nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
				<a href="#projects">Projects</a>
				<a href="#approach">Our approach</a>
				<a href="#studio">About</a>
				<a href="#contact">Get in touch ↗</a>
			</nav>
		</header>

		<main id="home">
			<section class="hero" aria-labelledby="hero-title">
				<img class="hero-image" src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2400&q=85" alt="Sculptural contemporary home framed by trees" fetchpriority="high" />
				<div class="hero-shade"></div>
				<div class="hero-copy">
					<p class="eyebrow light">CONSTRUCTION · PROJECTS · NEW ZEALAND</p>
					<h1 id="hero-title">Built with<br />purpose.</h1>
					<div class="hero-bottom">
						<p>We bring good ideas to life<br class="desktop-break" /> with care, craft and clarity.</p>
						<a class="round-link" href="#projects" aria-label="Explore projects"><span>↓</span></a>
					</div>
				</div>
				<div class="hero-index"><span>01</span> / 03</div>
			</section>

			<section class="intro section-pad" id="approach">
				<div class="intro-label"><span class="eyebrow">A PLACE, MADE WELL</span><span class="tiny-rule"></span></div>
				<div class="intro-content">
					<h2>Good work starts<br />with good thinking.</h2>
					<div class="intro-text">
						<p>ANDRO is a New Zealand construction and projects company. We bring people, process and practical know-how together to make considered ideas real.</p>
						<a class="text-link" href="#studio">A little about us <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="projects section-pad" id="projects">
				<div class="section-heading">
					<div><p class="eyebrow">OUR WORK</p><h2>Projects, built well</h2></div>
					<a class="text-link" href="#contact">Talk to us about a project <span aria-hidden="true">↗</span></a>
				</div>
				<div class="project-grid">
					<a class="project-card project-large" href="#contact" aria-label="Discuss a residential construction project">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1500&q=85" alt="Warm, sunlit interiors of a contemporary residence" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>Residential construction</h3><p>Thoughtful homes, made to last</p></div><span class="project-type">NEW ZEALAND</span></div>
					</a>
					<a class="project-card project-offset" href="#contact" aria-label="Discuss a renovation or refurbishment project">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85" alt="Refined modern living space opening onto a garden" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>Renovation &amp; renewal</h3><p>Fresh thinking for existing spaces</p></div><span class="project-type">NEW ZEALAND</span></div>
					</a>
				</div>
				<div class="project-grid project-grid-second">
					<a class="project-card" href="#contact" aria-label="Discuss a commercial or development project">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85" alt="Quiet architectural detail in a contemporary building" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>Projects &amp; development</h3><p>From early planning to delivery</p></div><span class="project-type">NEW ZEALAND</span></div>
					</a>
					<div class="project-note"><span class="eyebrow">MADE WITH INTENTION</span><p>Clear communication. Solid planning. Quality work, right down to the details.</p><a class="text-link" href="#approach">How we work <span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="manifesto" id="studio">
				<img src="https://images.unsplash.com/photo-1600607687644-c7171b42498f?auto=format&fit=crop&w=2200&q=85" alt="Thoughtful materials and architecture in a sunlit home" loading="lazy" />
				<div class="manifesto-shade"></div>
				<div class="manifesto-copy"><p class="eyebrow light">THE ANDRO APPROACH</p><h2>Good work is<br />built together.</h2><a class="light-link" href="#contact">Meet ANDRO <span aria-hidden="true">↗</span></a></div>
				<span class="manifesto-caption">NEW ZEALAND</span>
			</section>

			<section class="contact section-pad" id="contact">
				<p class="eyebrow">THE NEXT GOOD THING</p>
				<div class="contact-row"><h2>Have a project<br />in mind?</h2><a class="contact-circle" href="mailto:hello@andro.co.nz"><span>Let’s talk</span><b aria-hidden="true">↗</b></a></div>
				<div class="contact-bottom"><span>NEW ZEALAND</span><a href="mailto:hello@andro.co.nz">HELLO@ANDRO.CO.NZ</a><span>CONSTRUCTION + PROJECTS</span></div>
			</section>
		</main>

		<footer class="site-footer"><a class="footer-mark" href="#home">ANDRO</a><span>BUILT WITH PURPOSE.</span><div><a href="https://www.instagram.com/" target="_blank" rel="noreferrer">INSTAGRAM ↗</a><span>© ANDRO 2025</span></div></footer>
		<script>
			const menuButton = document.querySelector('.menu-toggle');
			const mobileMenu = document.querySelector('#mobile-menu');
			menuButton?.addEventListener('click', () => {
				const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isOpen));
				menuButton.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
				if (mobileMenu) mobileMenu.hidden = isOpen;
			});
			mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
				mobileMenu.hidden = true;
				menuButton?.setAttribute('aria-expanded', 'false');
				menuButton?.setAttribute('aria-label', 'Open menu');
			}));
		</script>
	</body>
</html>
