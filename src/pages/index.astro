---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="GRAYA — Built for living"
			description="Discover considered homes and enduring places by GRAYA, an Australian design and property studio."
		/>
		<meta name="theme-color" content="#f3f1ec" />
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="#home" aria-label="GRAYA home">GRAYA<span>™</span></a>
			<nav class="desktop-nav" aria-label="Main navigation">
				<a href="#projects">Projects</a>
				<a href="#approach">Our approach</a>
				<a href="#studio">Studio</a>
			</nav>
			<a class="header-cta" href="mailto:hello@graya.com.au">Start a conversation <span aria-hidden="true">↗</span></a>
			<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span><span></span>
			</button>
			<nav class="mobile-nav" id="mobile-menu" aria-label="Mobile navigation" hidden>
				<a href="#projects">Projects</a>
				<a href="#approach">Our approach</a>
				<a href="#studio">Studio</a>
				<a href="mailto:hello@graya.com.au">Get in touch ↗</a>
			</nav>
		</header>

		<main id="home">
			<section class="hero" aria-labelledby="hero-title">
				<img class="hero-image" src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2400&q=85" alt="Sculptural contemporary home framed by trees" fetchpriority="high" />
				<div class="hero-shade"></div>
				<div class="hero-copy">
					<p class="eyebrow light">DESIGN · DEVELOPMENT · CONSTRUCTION</p>
					<h1 id="hero-title">A little more<br />considered.</h1>
					<div class="hero-bottom">
						<p>We create places that feel like they<br class="desktop-break" /> could only ever be here.</p>
						<a class="round-link" href="#projects" aria-label="Explore projects"><span>↓</span></a>
					</div>
				</div>
				<div class="hero-index"><span>01</span> / 04</div>
			</section>

			<section class="intro section-pad" id="approach">
				<div class="intro-label"><span class="eyebrow">A PLACE, MADE WELL</span><span class="tiny-rule"></span></div>
				<div class="intro-content">
					<h2>Good places do more<br />than look the part.</h2>
					<div class="intro-text">
						<p>They bring people together. They make the everyday feel special. And they belong to their place, long after the keys have changed hands.</p>
						<a class="text-link" href="#studio">A little about us <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="projects section-pad" id="projects">
				<div class="section-heading">
					<div><p class="eyebrow">A FEW GOOD PLACES</p><h2>Selected projects</h2></div>
					<a class="text-link" href="mailto:hello@graya.com.au">Explore our work <span aria-hidden="true">↗</span></a>
				</div>
				<div class="project-grid">
					<a class="project-card project-large" href="mailto:hello@graya.com.au?subject=The%20Silo" aria-label="Enquire about The Silo, Newstead">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1500&q=85" alt="Warm, sunlit interiors of a contemporary residence" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>The Silo</h3><p>Newstead, Queensland</p></div><span class="project-type">RESIDENCES · 2025</span></div>
					</a>
					<a class="project-card project-offset" href="mailto:hello@graya.com.au?subject=Ivory" aria-label="Enquire about Ivory, Brisbane">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85" alt="Refined modern living space opening onto a garden" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>Ivory</h3><p>Brisbane, Queensland</p></div><span class="project-type">HOMES · 2024</span></div>
					</a>
				</div>
				<div class="project-grid project-grid-second">
					<a class="project-card" href="mailto:hello@graya.com.au?subject=Enclave" aria-label="Enquire about Enclave, Brisbane">
						<div class="project-image"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85" alt="Quiet architectural detail in a contemporary home" loading="lazy" /><span class="image-arrow">↗</span></div>
						<div class="project-meta"><div><h3>Enclave</h3><p>Paddington, Queensland</p></div><span class="project-type">HOMES · 2024</span></div>
					</a>
					<div class="project-note"><span class="eyebrow">MADE WITH INTENTION</span><p>From the first sketch to the final detail, every decision has a reason to be there.</p><a class="text-link" href="#studio">How we work <span aria-hidden="true">↗</span></a></div>
				</div>
			</section>

			<section class="manifesto" id="studio">
				<img src="https://images.unsplash.com/photo-1600607687644-c7171b42498f?auto=format&fit=crop&w=2200&q=85" alt="Thoughtful material palette and architecture in a sunlit home" loading="lazy" />
				<div class="manifesto-shade"></div>
				<div class="manifesto-copy"><p class="eyebrow light">THE GRAYA WAY</p><h2>Good design is<br />felt, not explained.</h2><a class="light-link" href="mailto:hello@graya.com.au">Meet the studio <span aria-hidden="true">↗</span></a></div>
				<span class="manifesto-caption">BRISBANE · AUSTRALIA</span>
			</section>

			<section class="contact section-pad">
				<p class="eyebrow">THE NEXT GOOD THING</p>
				<div class="contact-row"><h2>Have a place<br />in mind?</h2><a class="contact-circle" href="mailto:hello@graya.com.au"><span>Let’s talk</span><b aria-hidden="true">↗</b></a></div>
				<div class="contact-bottom"><span>BRISBANE, AUSTRALIA</span><a href="mailto:hello@graya.com.au">HELLO@GRAYA.COM.AU</a><span>DESIGN + CONSTRUCT</span></div>
			</section>
		</main>

		<footer class="site-footer"><a class="footer-mark" href="#home">GRAYA<span>™</span></a><span>MADE WITH INTENTION.</span><div><a href="https://www.instagram.com/" target="_blank" rel="noreferrer">INSTAGRAM ↗</a><span>© GRAYA 2025</span></div></footer>
		<script>
			const menuButton = document.querySelector('.menu-toggle');
			const mobileMenu = document.querySelector('#mobile-menu');
			menuButton?.addEventListener('click', () => {
				const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isOpen));
				menuButton.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
				if (mobileMenu) mobileMenu.hidden = isOpen;
			});
			mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
				mobileMenu.hidden = true;
				menuButton?.setAttribute('aria-expanded', 'false');
				menuButton?.setAttribute('aria-label', 'Open menu');
			}));
		</script>
	</body>
</html>
