---
import SiteLayout from '../components/SiteLayout.astro';
import { site, siteContent } from '../data/site';
const photos = siteContent.home.photos;
---
<SiteLayout title="ANDRO Construction + Projects | Construction and Property Maintenance Auckland" description={siteContent.home.introText}>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src={photos.hero.src} alt={photos.hero.alt} fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-copy reveal">
      <p class="eyebrow inverse">AUCKLAND · NEW ZEALAND · EST. {site.established}</p>
      <h1 id="hero-title"><span data-style-key="home.title">{siteContent.home.title}</span></h1>
      <div class="hero-bottom"><p class="hero-subtitle"><span data-style-key="home.subtitle">{siteContent.home.subtitle}</span></p></div>
    </div>
    <div class="hero-index"><strong>01</strong> / 03</div>
  </section>

  <section class="intro section-pad home-editorial-section home-intro" id="intro">
    <div class="intro-grid home-editorial-grid">
      <div class="home-editorial-lead">
        <div class="section-kicker home-editorial-kicker"><p class="eyebrow">ANDRO CONSTRUCTION + PROJECTS</p><span class="kicker-line" aria-hidden="true"></span></div>
        <h2 class="display-heading"><span data-style-key="home.introHeading">{siteContent.home.introHeading}</span></h2>
      </div>
      <div class="intro-copy home-editorial-copy"><p>{siteContent.home.introText}</p><p>We work with homeowners, landlords, property managers, businesses and commercial property owners. Whether you are planning a build, improving a space or dealing with a maintenance issue, we talk through the requirements and agree a practical way forward.</p><a class="text-link" href="/about/">Get to know ANDRO <span>↗</span></a></div>
    </div>
  </section>

  <section class="service-strip section-pad" aria-labelledby="services-title">
    <div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2 id="services-title"><span data-style-key="home.servicesHeading">{siteContent.home.servicesHeading}</span></h2></div><a class="text-link" href="/construction/">Explore construction <span>↗</span></a></div>
    <div class="editorial-grid">
      <a class="editorial-card" href="/construction/"><div class="editorial-image"><img src={photos.constructionCard.src} alt={photos.constructionCard.alt} loading="lazy" /></div><div class="card-meta"><div><h3>{siteContent.home.constructionCardTitle}</h3><p>{siteContent.home.constructionCardDescription}</p></div><span class="card-arrow">↗</span></div></a>
      <a class="editorial-card" href="/property-maintenance/"><div class="editorial-image"><img src={photos.maintenanceCard.src} alt={photos.maintenanceCard.alt} loading="lazy" /></div><div class="card-meta"><div><h3>{siteContent.home.maintenanceCardTitle}</h3><p>{siteContent.home.maintenanceCardDescription}</p></div><span class="card-arrow">↗</span></div></a>
    </div>
  </section>

  <section class="image-band" aria-label="ANDRO craftsmanship and approach">
    <img src={photos.feature.src} alt={photos.feature.alt} loading="lazy" />
    <div class="image-band-copy"><p class="eyebrow inverse">THE ANDRO APPROACH</p><h2><span data-style-key="home.featureHeading">{siteContent.home.featureHeading}</span></h2><a class="text-link" href="/about/">How we work <span>↗</span></a></div>
  </section>

  <section class="intro section-pad home-philosophy home-editorial-section">
    <div class="intro-grid home-editorial-grid">
      <div class="home-editorial-lead">
        <div class="section-kicker home-editorial-kicker"><p class="eyebrow">CRAFTSMANSHIP · QUALITY · SERVICE</p><span class="kicker-line" aria-hidden="true"></span></div>
        <h2 class="display-heading"><span data-style-key="home.philosophyHeading">{siteContent.home.philosophyHeading}</span></h2>
      </div>
      <div class="intro-copy home-editorial-copy"><p><span data-style-key="home.philosophyText">{siteContent.home.philosophyText}</span></p><p>Paint weathers. Gutters clog. Small leaks can allow moisture to reach surrounding materials. Attending to the early signs is often more practical than waiting until a minor repair has grown into a larger one.</p><a class="text-link" href="/property-maintenance/">Explore property maintenance <span>↗</span></a></div>
    </div>
  </section>

  <section class="cta-section"><div class="cta-row"><h2><span data-style-key="home.closingHeading">{siteContent.home.closingHeading}</span></h2><a class="text-link" href="/contact/">Start a conversation <span>↗</span></a></div></section>
</SiteLayout>

<style>

  /* Scaled, balanced homepage editorial blocks with centred left-column text. */
  .home-editorial-section { padding-top: clamp(74px, 7.2vw, 112px); padding-bottom: clamp(78px, 7.8vw, 118px); }
  .home-editorial-section .home-editorial-grid {
    max-width: 1340px; width: 100%; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    gap: clamp(44px, 6vw, 108px); align-items: center;
  }
  .home-editorial-lead {
    min-width: 0; max-width: 660px; margin-inline: auto;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
  }
  .home-editorial-kicker { justify-content: center; gap: 14px; margin-bottom: clamp(24px, 2.7vw, 38px); }
  .home-editorial-kicker .eyebrow { margin: 0; }
  .home-editorial-kicker .kicker-line { width: 32px; }
  .home-editorial-lead .display-heading {
    max-width: 620px; margin: 0; font-size: clamp(37px, 4.45vw, 63px);
    font-weight: 300; line-height: 1.12; letter-spacing: -.07em; text-wrap: balance;
  }
  .home-editorial-copy { width: 100%; max-width: 465px; margin-inline: auto; padding: 0; }
  .home-editorial-copy p { margin: 0 0 20px; font-size: clamp(13px, 1.04vw, 15px); line-height: 1.82; }
  .home-editorial-copy .text-link { margin-top: 2px; }
  @media (max-width: 900px) {
    .home-editorial-section .home-editorial-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(28px, 4vw, 52px);
    }
    .home-editorial-lead .display-heading { font-size: clamp(34px, 4.8vw, 51px); }
  }
  @media (max-width: 680px) {
    .home-editorial-section { padding-top: 66px; padding-bottom: 75px; }
    .home-editorial-section .home-editorial-grid { grid-template-columns: 1fr; gap: 34px; }
    .home-editorial-lead .display-heading { font-size: clamp(37px, 9vw, 55px); }
    .home-editorial-kicker { margin-bottom: 22px; }
    .home-editorial-copy { max-width: 540px; }
    .home-editorial-copy p { font-size: 14px; line-height: 1.78; }
  }
  /* Compact homepage service cards: preserve the two-column layout and existing photos. */
  .service-strip {
    padding-top: clamp(48px, 4.5vw, 66px);
    padding-bottom: clamp(54px, 5.5vw, 78px);
  }
  .service-strip .section-heading { margin-bottom: clamp(22px, 2.8vw, 34px); }
  /* Centre a narrower pair of cards and line up the heading with their edges. */
  .service-strip .section-heading,
  .service-strip .editorial-grid { width: 100%; max-width: 1080px; margin-inline: auto; }
  .service-strip .editorial-image { aspect-ratio: 1.85 / 1; }
  .service-strip .card-meta { padding-top: 12px; }
  @media (max-width: 680px) {
    .service-strip { padding-top: 46px; padding-bottom: 56px; }
    .service-strip .editorial-image { aspect-ratio: 1.3 / 1; }
  }
</style>
