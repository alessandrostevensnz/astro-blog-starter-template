---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery, site, siteContent } from '../data/site';
---
<SiteLayout title="ANDRO Construction + Projects — EST. 2020" description={siteContent.home.introText}>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src={imagery.hero.src} alt={imagery.hero.alt} fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-copy reveal">
      <p class="eyebrow inverse">AUCKLAND · NEW ZEALAND · EST. {site.established}</p>
      <h1 id="hero-title">{siteContent.home.title}</h1>
      <div class="hero-bottom"><p class="hero-subtitle">{siteContent.home.subtitle}</p></div>
    </div>
    <div class="hero-index"><strong>01</strong> / 03</div>
  </section>

  <section class="intro section-pad" id="intro">
    <div class="section-kicker"><p class="eyebrow">ANDRO CONSTRUCTION + PROJECTS</p><span class="kicker-line"></span></div>
    <div class="intro-grid">
      <h2 class="display-heading">{siteContent.home.introHeading}</h2>
      <div class="intro-copy"><p>{siteContent.home.introText}</p><p>Our focus is straightforward: thoughtful planning, quality workmanship and dependable project delivery.</p><a class="text-link" href="/about/">Get to know ANDRO <span>↗</span></a></div>
    </div>
  </section>

  <section class="service-strip section-pad" aria-labelledby="services-title">
    <div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2 id="services-title">{siteContent.home.servicesHeading}</h2></div><a class="text-link" href="/construction/">Explore services <span>↗</span></a></div>
    <div class="editorial-grid">
      <a class="editorial-card" href="/construction/"><div class="editorial-image"><img src={imagery.construction.src} alt={imagery.construction.alt} loading="lazy" /></div><div class="card-meta"><div><h3>{siteContent.home.constructionCardTitle}</h3><p>{siteContent.home.constructionCardDescription}</p></div><span class="card-arrow">↗</span></div></a>
      <a class="editorial-card" href="/property-maintenance/"><div class="editorial-image"><img src={imagery.maintenance.src} alt={imagery.maintenance.alt} loading="lazy" /></div><div class="card-meta"><div><h3>{siteContent.home.maintenanceCardTitle}</h3><p>{siteContent.home.maintenanceCardDescription}</p></div><span class="card-arrow">↗</span></div></a>
    </div>
  </section>

  <section class="image-band" aria-label="ANDRO construction and projects">
    <img src={imagery.detail.src} alt={imagery.detail.alt} loading="lazy" />
    <div class="image-band-copy"><p class="eyebrow inverse">THE ANDRO APPROACH</p><h2>{siteContent.home.featureHeading}</h2><a class="text-link" href="/about/">How we work <span>↗</span></a></div>
  </section>

  <section class="intro section-pad"><div class="section-kicker"><p class="eyebrow">OUR WORK</p><span class="kicker-line"></span></div><div class="intro-grid"><h2 class="display-heading">Made for the long run.</h2><div class="intro-copy"><p>Every site and brief is different. We bring a considered approach to each project, with clear communication from the first conversation through delivery.</p><a class="text-link" href="/projects/">Explore project types <span>↗</span></a></div></div></section>

  <section class="cta-section"><div class="cta-row"><h2>{siteContent.home.closingHeading}</h2><a class="text-link" href="/contact/">Start a conversation <span>↗</span></a></div></section>
</SiteLayout>
