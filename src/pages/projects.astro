---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery } from '../data/site';
const entries = [
  { title: 'Residential construction', category: 'Construction · Residential', image: imagery.home },
  { title: 'Commercial construction', category: 'Construction · Commercial', image: imagery.construction },
  { title: 'Renovations', category: 'Construction · Renovation', image: imagery.exterior },
  { title: 'Property + asset maintenance', category: 'Maintenance · Residential + commercial', image: imagery.maintenance },
];
---
<SiteLayout title="Projects — ANDRO Construction + Projects" description="Explore the types of construction, renovation and maintenance work ANDRO can discuss in Auckland.">
  <section class="page-hero"><p class="eyebrow">PROJECTS · AUCKLAND, NEW ZEALAND</p><h1>Every brief<br />starts somewhere.</h1><p class="lead">A look at the kinds of construction, renovation and property work we can discuss. Images are illustrative placeholders, not a portfolio of completed ANDRO projects.</p></section>
  <section class="page-body section-pad"><div class="project-grid">{entries.map((entry) => <article class="project-card"><div class="project-image"><img src={entry.image.src} alt={entry.image.alt} loading="lazy" /><span class="image-placeholder-note">Illustrative image · not an ANDRO project</span></div><div class="project-copy"><h2>{entry.title}</h2><p>{entry.category}</p></div></article>)}</div><p class="notice">No completed projects are represented here. This gallery uses temporary stock photography to show service categories. Replace these image references in <code>src/data/site.ts</code> with ANDRO-owned images when ready.</p></section>
  <section class="cta-section"><div class="cta-row"><h2>Have a brief<br />to share?</h2><a class="text-link" href="/contact/">Let’s discuss it <span>↗</span></a></div></section>
</SiteLayout>
