---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent, pageContent } from '../data/site';
import optimizedGallery from '../data/project-gallery-optimized.generated.json';
const galleryImages = optimizedGallery as Record<string, { small: string; large: string; hero?: string }>;
const projectCopy = pageContent.projects;
const projectsHero = projectCopy.photos.hero;
const optimizedHero = galleryImages[projectsHero.src];
const projectsHeroVideo = pageContent.projects.heroVideo?.trim() || '';
// Use the first frame of the actual video while it buffers (same visual as Asset Maintenance).
const projectsHeroPoster = pageContent.projects.heroVideoPoster?.trim() || (optimizedHero?.hero ?? projectsHero.src);
---
<SiteLayout title={projectCopy.metaTitle} description={projectCopy.metaDescription}>
  <section class="page-hero projects-photo-hero" aria-labelledby="projects-hero-title">
    <img
      class:list={['projects-hero-image', { 'projects-hero-video-poster': !!projectsHeroVideo }]}
      src={projectsHeroVideo ? projectsHeroPoster : (optimizedHero?.hero ?? projectsHero.src)}
      srcset={!projectsHeroVideo && optimizedHero?.hero && optimizedHero?.large ? `${optimizedHero.large} 960w, ${optimizedHero.hero} 1800w` : undefined}
      sizes="100vw"
      alt={projectsHero.alt}
      fetchpriority="high"
      decoding="async"
    />
    {projectsHeroVideo && (
      <video
        class="projects-hero-video" data-background-video
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster={projectsHeroPoster}
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
        disableremoteplayback
      >
        <source src={projectsHeroVideo} type="video/mp4" />
      </video>
    )}
    <div class="projects-hero-shade" aria-hidden="true"></div>
    <div class="projects-hero-content">
      <p class="eyebrow inverse" data-style-key="projects.heroEyebrow">{projectCopy.heroEyebrow}</p>
      <h1 id="projects-hero-title" data-style-key="projects.heroHeading">{projectCopy.heroHeading}</h1>
      <p class="lead" data-style-key="projects.heroDescription">{projectCopy.heroDescription}</p>
    </div>
  </section>
  <section class="page-body section-pad">
    <div class="andro-projects-gallery-head">
      <p class="andro-projects-tip" data-style-key="projects.galleryTip">{projectCopy.galleryTip}</p>
      <nav class="andro-projects-navigation" data-project-navigation aria-label="Browse project photographs" hidden>
        <span class="andro-projects-count" data-project-count aria-live="polite" aria-atomic="true"></span>
        <div class="andro-projects-navigation-buttons">
          <button class="andro-gallery-arrow" type="button" data-project-prev aria-label="Previous three project photos" disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button class="andro-gallery-arrow" type="button" data-project-next aria-label="Next three project photos">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </nav>
    </div>
    <div class="andro-projects-grid" data-project-gallery aria-label="Project showcase, two rows of photos">
      {siteContent.projects.map((entry) => (
        <button
          type="button"
          class="andro-project-tile"
          data-project-tile
          aria-expanded="false"
          aria-label={entry.title + (entry.description ? '. ' + entry.description : '. ' + entry.category)}
        >
          <img
            src={galleryImages[entry.image]?.large ?? entry.image}
            srcset={galleryImages[entry.image] ? `${galleryImages[entry.image].small} 480w, ${galleryImages[entry.image].large} 960w` : undefined}
            sizes={galleryImages[entry.image] ? '(max-width: 760px) 43vw, (max-width: 1200px) 27vw, 400px' : undefined}
            alt={entry.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="andro-project-overlay">
            <span class="andro-project-category" data-cms-text>{entry.category}</span>
            <span class="andro-project-title" data-cms-text>{entry.title}</span>
            {entry.description && <span class="andro-project-description" data-cms-text>{entry.description}</span>}
          </span>
        </button>
      ))}
    </div>
    <p class="body-copy projects-note" data-style-key="projects.galleryNote">{projectCopy.galleryNote}</p>
  </section>
  <section class="cta-section"><div class="cta-row"><h2 class="projects-cta-heading" data-style-key="projects.ctaHeading">{projectCopy.ctaHeading}</h2><a class="text-link" href="/contact/" data-style-key="projects.ctaButtonText">{projectCopy.ctaButtonText}</a></div></section>
</SiteLayout>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  const tiles = Array.from(gallery?.querySelectorAll<HTMLButtonElement>('[data-project-tile]') ?? []);
  const galleryNavigation = document.querySelector<HTMLElement>('[data-project-navigation]');
  const previousButton = galleryNavigation?.querySelector<HTMLButtonElement>('[data-project-prev]');
  const nextButton = galleryNavigation?.querySelector<HTMLButtonElement>('[data-project-next]');
  const galleryCount = galleryNavigation?.querySelector<HTMLElement>('[data-project-count]');
  const smallScreen = window.matchMedia('(max-width: 760px)');
  const noHover = window.matchMedia('(hover: none)');
  const collapse = () => tiles.forEach(tile => tile.setAttribute('aria-expanded', 'false'));

  // Show two rows: 3 across on desktop, 2 across on phones.
  // The arrows move through 3 photos per click, with no automatic rotation.
  if (gallery && galleryNavigation && previousButton && nextButton && galleryCount && tiles.length > 0) {
    let firstPhoto = 0;
    const moveBy = 3;
    const format = (value: number) => String(value).padStart(2, '0');
    const renderGallery = () => {
      const visiblePhotos = smallScreen.matches ? 4 : 6;
      const maxFirstPhoto = Math.max(0, tiles.length - visiblePhotos);
      firstPhoto = Math.min(firstPhoto, maxFirstPhoto);
      tiles.forEach((tile, index) => {
        const visible = index >= firstPhoto && index < firstPhoto + visiblePhotos;
        tile.hidden = !visible;
        if (!visible) tile.setAttribute('aria-expanded', 'false');
      });
      previousButton.disabled = firstPhoto === 0;
      nextButton.disabled = firstPhoto >= maxFirstPhoto;
      galleryCount.textContent = `${format(firstPhoto + 1)}–${format(Math.min(tiles.length, firstPhoto + visiblePhotos))} / ${format(tiles.length)}`;
    };
    galleryNavigation.hidden = false;
    previousButton.addEventListener('click', () => {
      firstPhoto = Math.max(0, firstPhoto - moveBy);
      collapse();
      renderGallery();
    });
    nextButton.addEventListener('click', () => {
      firstPhoto = Math.min(Math.max(0, tiles.length - (smallScreen.matches ? 4 : 6)), firstPhoto + moveBy);
      collapse();
      renderGallery();
    });
    smallScreen.addEventListener('change', renderGallery);
    renderGallery();
  }

  // On touchscreens, tap a project to reveal or hide its description.
  tiles.forEach(tile => tile.addEventListener('click', () => {
    if (!noHover.matches) return;
    const shouldOpen = tile.getAttribute('aria-expanded') !== 'true';
    collapse();
    if (shouldOpen) tile.setAttribute('aria-expanded', 'true');
  }));
  document.addEventListener('pointerdown', event => {
    if (noHover.matches && event.target instanceof Node && !event.target.parentElement?.closest('[data-project-tile]')) collapse();
  });
</script>
<style>
  /* Projects photo header matches ANDRO's construction and other photo-led pages. */
  .page-hero.projects-photo-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 52vw, 710px);
    overflow: hidden;
    padding: clamp(105px, 10vw, 150px) 10%;
    background: #343a37;
    color: #fff;
  }
  .projects-hero-image,
  .projects-hero-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  .projects-hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .projects-hero-image {
    z-index: -2;
    object-fit: cover;
    object-position: center 45%;
  }
  /* Use the identical crop for the loading frame and the moving video. */
  .projects-hero-video-poster { object-position: center; }
  .projects-hero-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(13,16,15,.78) 0%, rgba(13,16,15,.63) 47%, rgba(13,16,15,.27) 100%),
      linear-gradient(0deg, rgba(13,16,15,.24), transparent 64%);
  }
  .projects-hero-content { position: relative; max-width: 900px; }
  .projects-photo-hero .eyebrow { color: var(--brand-accent-soft); }
  .projects-photo-hero h1 {
    white-space: pre-line;
    max-width: 900px;
    color: #fff;
    font-size: clamp(61px, 8vw, 108px);
    line-height: .97;
    text-wrap: balance;
  }
  .projects-photo-hero .lead {
    max-width: 690px;
    color: rgba(255,255,255,.94);
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.8;
  }
  @media (max-width: 680px) {
    .page-hero.projects-photo-hero { min-height: 580px; padding: 92px 7% 94px; }
    .projects-photo-hero h1 { font-size: clamp(52px, 12vw, 78px); }
    .projects-photo-hero .lead { font-size: 13px; line-height: 1.75; }
    .projects-hero-image { object-position: 55% center; }
    .projects-hero-video-poster { object-position: center; }
    .projects-hero-shade {
      background: linear-gradient(90deg, rgba(13,16,15,.83), rgba(13,16,15,.55)),
                  linear-gradient(0deg, rgba(13,16,15,.2), transparent);
    }
  }

  .andro-projects-gallery-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px 24px; margin: 0 0 24px; }
  .andro-projects-tip { flex: 1 1 320px; margin: 0; color: var(--brand-muted); font-size: 12px; line-height: 1.6; }
  .andro-projects-navigation { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .andro-projects-navigation[hidden] { display: none !important; }
  .andro-projects-count { color: var(--brand-muted); font-size: 11px; letter-spacing: .13em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .andro-projects-navigation-buttons { display: flex; align-items: center; gap: 8px; }
  .andro-gallery-arrow { display: grid; place-items: center; width: 45px; height: 45px; padding: 0; border: 1px solid #b49b70; border-radius: 0; color: #262724; background: transparent; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .andro-gallery-arrow:not(:disabled):hover { background: #262724; color: #fff; }
  .andro-gallery-arrow:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 3px; }
  .andro-gallery-arrow:disabled { opacity: .32; cursor: not-allowed; }
  .andro-gallery-arrow svg { display: block; }
  /* A fixed two-row gallery; only the arrows change which photos are shown. */
  .andro-projects-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
  .andro-project-tile[hidden] { display: none !important; }
  .andro-project-tile { display: block; position: relative; min-width: 0; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; background: #d4d0c8; color: #fff; text-align: left; cursor: pointer; }
  .andro-project-tile img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .andro-project-overlay { display: flex; flex-direction: column; justify-content: end; gap: 7px; position: absolute; inset: 0; padding: clamp(10px, 1.1vw, 18px); background: linear-gradient(180deg, rgba(10,12,11,.17), rgba(10,12,11,.89)); color: #fff; opacity: 0; transform: translateY(6px); transition: opacity .25s ease, transform .25s ease; pointer-events: none; overflow: hidden; }
  .andro-project-category { color: #dfcba7; font-size: 10px; line-height: 1.3; letter-spacing: .07em; text-transform: uppercase; }
  .andro-project-title { font-family: var(--font-display); font-size: clamp(15px, 1.35vw, 22px); font-weight: 400; letter-spacing: -.04em; line-height: 1.14; }
  .andro-project-description { color: rgba(255,255,255,.94); font-size: 12px; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  @media (hover: hover) {
    .andro-project-tile:hover img { transform: scale(1.045); }
    .andro-project-tile:hover .andro-project-overlay { opacity: 1; transform: translateY(0); }
  }
  .andro-project-tile:focus-visible { outline: 3px solid var(--brand-accent); outline-offset: 3px; }
  .andro-project-tile:focus-visible .andro-project-overlay, .andro-project-tile[aria-expanded="true"] .andro-project-overlay { opacity: 1; transform: translateY(0); }
  .andro-project-tile[aria-expanded="true"] img { transform: scale(1.045); }
  .projects-note { margin-top: 50px; max-width: 760px; }
  .projects-cta-heading { white-space: pre-line; }
  @media (max-width: 760px) { .andro-projects-gallery-head { align-items: flex-start; } .andro-projects-navigation { margin-left: 0; } .andro-projects-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; } .andro-project-tile { aspect-ratio: 1 / 1.12; } .andro-project-title { font-size: clamp(15px, 3.5vw, 21px); } .andro-project-description { font-size: 11px; line-height: 1.45; } }
  @media (max-width: 420px) { .andro-projects-navigation { width: 100%; justify-content: space-between; } }
  @media (max-width: 400px) { .andro-project-overlay { padding: 10px; gap: 5px; } .andro-project-category { font-size: 9px; } .andro-project-title { font-size: 15px; } .andro-project-description { font-size: 10px; -webkit-line-clamp: 3; } }
  @media (prefers-reduced-motion: reduce) { .andro-project-tile img, .andro-project-overlay { transition: none; } }
</style>
