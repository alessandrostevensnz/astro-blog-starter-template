---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery, siteContent } from '../data/site';
---
<SiteLayout title="Projects — ANDRO Construction + Projects" description="Explore residential and commercial construction, interior lining, fencing and balustrade work from ANDRO Construction + Projects in Auckland.">
  <section class="page-hero">
    <p class="eyebrow">PROJECTS · AUCKLAND, NEW ZEALAND</p>
    <h1>Every brief<br />starts somewhere.</h1>
    <p class="lead">A selection of residential and commercial construction work, including framing, interior lining, fencing and balustrade details.</p>
  </section>
  <section class="page-body section-pad">
    <div class="project-grid">
      {siteContent.projects.map((entry) => (
        <article class="project-card">
          <div class="project-image"><img src={entry.image} alt={entry.alt} loading="lazy" /></div>
          <div class="project-copy"><h2>{entry.title}</h2><p>{entry.category}</p></div>
        </article>
      ))}
    </div>
  </section>
  <section class="cta-section"><div class="cta-row"><h2>Have a brief<br />to share?</h2><a class="text-link" href="/contact/">Let’s discuss it <span>↗</span></a></div></section>
</SiteLayout>
