---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery } from '../data/site';

const entries = [
  { title: 'Residential framing', category: 'Construction · Residential', image: imagery.home },
  { title: 'Residential home exterior', category: 'Construction · Residential', image: imagery.exterior },
  { title: 'Commercial framing', category: 'Construction · Commercial', image: imagery.construction },
  { title: 'Commercial project', category: 'Construction · Commercial', image: imagery.commercial },
  { title: 'Commercial wall cavity', category: 'Construction · Commercial', image: imagery.commercialCavity },
  { title: 'Commercial GIB lining', category: 'Construction · Interior lining', image: imagery.commercialGib },
  { title: 'Fencing', category: 'Exterior works · Residential + commercial', image: imagery.maintenance },
  { title: 'Balustrade', category: 'Construction · Detail work', image: imagery.detail },
];
---
<SiteLayout title="Projects — ANDRO Construction + Projects" description="Explore residential and commercial construction, interior lining, fencing and balustrade work from ANDRO Construction + Projects in Auckland.">
  <section class="page-hero">
    <p class="eyebrow">PROJECTS · AUCKLAND, NEW ZEALAND</p>
    <h1>Every brief<br />starts somewhere.</h1>
    <p class="lead">A selection of residential and commercial construction work, including framing, interior lining, fencing and balustrade details.</p>
  </section>
  <section class="page-body section-pad">
    <div class="project-grid">
      {entries.map((entry) => (
        <article class="project-card">
          <div class="project-image">
            <img src={entry.image.src} alt={entry.image.alt} loading="lazy" />
          </div>
          <div class="project-copy">
            <h2>{entry.title}</h2>
            <p>{entry.category}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="cta-section">
    <div class="cta-row"><h2>Have a brief<br />to share?</h2><a class="text-link" href="/contact/">Let’s discuss it <span>↗</span></a></div>
  </section>
</SiteLayout>
