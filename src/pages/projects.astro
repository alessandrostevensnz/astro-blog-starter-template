---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent } from '../data/site';
import optimizedGallery from '../data/project-gallery-optimized.generated.json';
const galleryImages = optimizedGallery as Record<string, {small: string; large: string}>;
---
<SiteLayout title="Projects | ANDRO Construction + Projects Auckland" description="Explore a selection of residential and commercial construction work, carpentry, interior lining and property improvements by ANDRO in Auckland.">
  <section class="page-hero"><p class="eyebrow">PROJECTS · AUCKLAND, NEW ZEALAND</p><h1>Every brief<br />starts somewhere.</h1><p class="lead">Buildings are shaped by hundreds of decisions, from the structure and materials to the way each finish meets. This selection shows examples of residential and commercial construction work, including framing, interior lining, fencing and balustrade details.</p></section>
  <section class="page-body section-pad">
    <p class="andro-projects-tip">Hover over a photo to learn more. On a phone, tap to reveal the description.</p>
    <div class="andro-projects-grid" aria-label="Project showcase">
      {siteContent.projects.map((entry) => (
        <button
          type="button"
          class="andro-project-tile"
          data-project-tile
          aria-expanded="false"
          aria-label={entry.title + (entry.description ? '. ' + entry.description : '. ' + entry.category)}
        >
          <img
            src={galleryImages[entry.image]?.large ?? entry.image}
            srcset={galleryImages[entry.image] ? `${galleryImages[entry.image].small} 480w, ${galleryImages[entry.image].large} 960w` : undefined}
            sizes={galleryImages[entry.image] ? '(max-width: 760px) 50vw, (max-width: 1050px) 33vw, (max-width: 1180px) 25vw, 20vw' : undefined}
            alt={entry.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="andro-project-overlay">
            <span class="andro-project-category">{entry.category}</span>
            <span class="andro-project-title">{entry.title}</span>
            {entry.description && <span class="andro-project-description">{entry.description}</span>}
          </span>
        </button>
      ))}
    </div>
    <p class="body-copy projects-note">Every property and project has its own requirements. If you have a similar brief—or a different one—get in touch and tell us what you are looking to achieve.</p>
  </section>
  <section class="cta-section"><div class="cta-row"><h2>Have a brief<br />to share?</h2><a class="text-link" href="/contact/">Let’s discuss it <span>↗</span></a></div></section>
</SiteLayout>

<script>
  // On touchscreens, tap a project to reveal or hide its description.
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-tile]'));
  const noHover = window.matchMedia('(hover: none)');
  const collapse = () => tiles.forEach(tile => tile.setAttribute('aria-expanded', 'false'));
  tiles.forEach(tile => tile.addEventListener('click', () => {
    if (!noHover.matches) return;
    const shouldOpen = tile.getAttribute('aria-expanded') !== 'true';
    collapse();
    if (shouldOpen) tile.setAttribute('aria-expanded', 'true');
  }));
  document.addEventListener('pointerdown', event => {
    if (noHover.matches && event.target instanceof Node && !event.target.parentElement?.closest('[data-project-tile]')) collapse();
  });
</script>
<style>
  .andro-projects-tip { margin: 0 0 22px; color: var(--brand-muted); font-size: 12px; line-height: 1.6; }
  .andro-projects-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 14px; }
  .andro-project-tile { display: block; position: relative; min-width: 0; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 0; overflow: hidden; background: #d4d0c8; color: #fff; text-align: left; cursor: pointer; }
  .andro-project-tile img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .andro-project-overlay { display: flex; flex-direction: column; justify-content: end; gap: 7px; position: absolute; inset: 0; padding: clamp(10px, 1.1vw, 18px); background: linear-gradient(180deg, rgba(10,12,11,.17), rgba(10,12,11,.89)); color: #fff; opacity: 0; transform: translateY(6px); transition: opacity .25s ease, transform .25s ease; pointer-events: none; overflow: hidden; }
  .andro-project-category { color: #dfcba7; font-size: 10px; line-height: 1.3; letter-spacing: .07em; text-transform: uppercase; }
  .andro-project-title { font-family: var(--font-display); font-size: clamp(15px, 1.35vw, 22px); font-weight: 400; letter-spacing: -.04em; line-height: 1.14; }
  .andro-project-description { color: rgba(255,255,255,.94); font-size: 12px; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  @media (hover: hover) {
    .andro-project-tile:hover img { transform: scale(1.045); }
    .andro-project-tile:hover .andro-project-overlay { opacity: 1; transform: translateY(0); }
  }
  .andro-project-tile:focus-visible { outline: 3px solid var(--brand-accent); outline-offset: 3px; }
  .andro-project-tile:focus-visible .andro-project-overlay, .andro-project-tile[aria-expanded="true"] .andro-project-overlay { opacity: 1; transform: translateY(0); }
  .andro-project-tile[aria-expanded="true"] img { transform: scale(1.045); }
  .projects-note { margin-top: 50px; max-width: 760px; }
  @media (max-width: 1180px) { .andro-projects-grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  @media (max-width: 1050px) { .andro-projects-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
  @media (max-width: 760px) { .andro-projects-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; } .andro-project-tile { aspect-ratio: 1 / 1.12; } .andro-project-title { font-size: clamp(15px, 3.5vw, 21px); } .andro-project-description { font-size: 11px; line-height: 1.45; } }
  @media (max-width: 400px) { .andro-project-overlay { padding: 10px; gap: 5px; } .andro-project-category { font-size: 9px; } .andro-project-title { font-size: 15px; } .andro-project-description { font-size: 10px; -webkit-line-clamp: 3; } }
  @media (prefers-reduced-motion: reduce) { .andro-project-tile img, .andro-project-overlay { transition: none; } }
</style>
