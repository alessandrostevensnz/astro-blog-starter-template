---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent, pageContent } from '../data/site';
import optimizedGallery from '../data/project-gallery-optimized.generated.json';
const galleryImages = optimizedGallery as Record<string, { small: string; large: string; hero?: string }>;
const projectCopy = pageContent.projects;
const projectsHero = projectCopy.photos.hero;
const optimizedHero = galleryImages[projectsHero.src];
const projectsHeroVideo = pageContent.projects.heroVideo?.trim() || '';
// Use the first frame of the actual video while it buffers (same visual as Asset Maintenance).
const projectsHeroPoster = pageContent.projects.heroVideoPoster?.trim() || (optimizedHero?.hero ?? projectsHero.src);
---
<SiteLayout title={projectCopy.metaTitle} description={projectCopy.metaDescription}>
  <section class="page-hero projects-photo-hero" aria-labelledby="projects-hero-title">
    <img
      class:list={['projects-hero-image', { 'projects-hero-video-poster': !!projectsHeroVideo }]}
      src={projectsHeroVideo ? projectsHeroPoster : (optimizedHero?.hero ?? projectsHero.src)}
      srcset={!projectsHeroVideo && optimizedHero?.hero && optimizedHero?.large ? `${optimizedHero.large} 960w, ${optimizedHero.hero} 1800w` : undefined}
      sizes="100vw"
      alt={projectsHero.alt}
      fetchpriority="high"
      decoding="async"
    />
    {projectsHeroVideo && (
      <video
        class="projects-hero-video" data-background-video
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster={projectsHeroPoster}
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
        disableremoteplayback
      >
        <source src={projectsHeroVideo} type="video/mp4" />
      </video>
    )}
    <div class="projects-hero-shade" aria-hidden="true"></div>
    <div class="projects-hero-content">
      <p class="eyebrow inverse" data-style-key="projects.heroEyebrow">{projectCopy.heroEyebrow}</p>
      <h1 id="projects-hero-title" data-style-key="projects.heroHeading">{projectCopy.heroHeading}</h1>
      <p class="lead" data-style-key="projects.heroDescription">{projectCopy.heroDescription}</p>
    </div>
  </section>
  <section class="page-body section-pad">
    <div class="andro-projects-gallery-head">
      <p class="andro-projects-tip" data-style-key="projects.galleryTip">{projectCopy.galleryTip}</p>
      <nav class="andro-projects-navigation" data-project-navigation aria-label="Browse project photographs" hidden>
        <span class="andro-projects-count" data-project-count aria-live="polite" aria-atomic="true"></span>
        <div class="andro-projects-navigation-buttons">
          <button class="andro-gallery-arrow" type="button" data-project-prev aria-label="Slide project photos left">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button class="andro-gallery-arrow" type="button" data-project-next aria-label="Slide project photos right">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </nav>
    </div>
    <div class="andro-projects-viewport" data-project-viewport tabindex="0" role="region" aria-label="Project photographs, arranged two rows high; use arrow buttons or swipe to browse">
      <div class="andro-projects-grid" data-project-gallery aria-label="Slowly moving project showcase, two rows of photographs">
      {siteContent.projects.map((entry) => (
        <figure class="andro-project-tile" data-project-tile>
          <img
            src={galleryImages[entry.image]?.large ?? entry.image}
            srcset={galleryImages[entry.image] ? `${galleryImages[entry.image].small} 480w, ${galleryImages[entry.image].large} 960w` : undefined}
            sizes={galleryImages[entry.image] ? '(max-width: 760px) 44vw, 18vw' : undefined}
            alt={entry.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="andro-project-overlay">
            <span class="andro-project-category" data-cms-text>{entry.category}</span>
            <span class="andro-project-title" data-cms-text>{entry.title}</span>
            {entry.description && <span class="andro-project-description" data-cms-text>{entry.description}</span>}
          </figcaption>
        </figure>
      ))}
      </div>
    </div>
    <p class="body-copy projects-note" data-style-key="projects.galleryNote">{projectCopy.galleryNote}</p>
  </section>
  <section class="cta-section"><div class="cta-row"><h2 class="projects-cta-heading" data-style-key="projects.ctaHeading">{projectCopy.ctaHeading}</h2><a class="text-link" href="/contact/" data-style-key="projects.ctaButtonText">{projectCopy.ctaButtonText}</a></div></section>
</SiteLayout>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  const viewport = document.querySelector<HTMLElement>('[data-project-viewport]');
  const uniqueTiles = Array.from(gallery?.querySelectorAll<HTMLElement>('[data-project-tile]') ?? []);
  const controls = document.querySelector<HTMLElement>('[data-project-navigation]');
  const prev = controls?.querySelector<HTMLButtonElement>('[data-project-prev]');
  const next = controls?.querySelector<HTMLButtonElement>('[data-project-next]');
  const counter = controls?.querySelector<HTMLElement>('[data-project-count]');
  const smallScreen = window.matchMedia('(max-width: 760px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // A column contains two photos. Duplicating each complete cycle permits
  // continuously moving through projects without a visible jump at the end.
  if (gallery && viewport && controls && prev && next && counter && uniqueTiles.length) {
    const uniquePhotoCount = uniqueTiles.length;
    const rows = 2;
    const totalColumns = Math.ceil(uniquePhotoCount / rows);
    const columnsPerClick = () => smallScreen.matches ? 1 : 3;
    const decorate = (tile: HTMLElement) => {
      tile.setAttribute('aria-hidden', 'true');
      tile.querySelector('img')?.setAttribute('alt', '');
      return tile;
    };
    // The odd final entry gets a matching partner to keep each repeated
    // copy aligned as two complete rows (45 saved photos are preserved).
    if (uniquePhotoCount % rows) {
      gallery.appendChild(decorate(uniqueTiles[uniquePhotoCount - 1].cloneNode(true) as HTMLElement));
    }
    const firstCopy = Array.from(gallery.querySelectorAll<HTMLElement>('[data-project-tile]'));
    const secondCopy = firstCopy.map(tile => decorate(tile.cloneNode(true) as HTMLElement));
    secondCopy.forEach(tile => gallery.appendChild(tile));

    let columnWidth = 0;
    let loopWidth = 0;
    let lastTime = 0;
    let pauseUntil = performance.now() + 750;
    let pointerOver = false;
    let touching = false;
    let hasFocus = false;
    let announcedColumn = -1;
    const number = (value: number) => String(value).padStart(2, '0');
    const measure = (preserve = false) => {
      const previousLoop = loopWidth;
      const previousScroll = viewport.scrollLeft;
      columnWidth = firstCopy[2]
        ? firstCopy[2].offsetLeft - firstCopy[0].offsetLeft
        : viewport.clientWidth / (smallScreen.matches ? 2 : 5);
      loopWidth = secondCopy[0].offsetLeft - firstCopy[0].offsetLeft;
      if (preserve && previousLoop > 0 && loopWidth > 0)
        viewport.scrollLeft = previousScroll / previousLoop * loopWidth;
      announcedColumn = -1;
    };
    const updateCount = () => {
      if (columnWidth <= 0 || loopWidth <= 0) return;
      const offset = ((viewport.scrollLeft % loopWidth) + loopWidth) % loopWidth;
      const column = Math.min(totalColumns - 1, Math.floor(offset / columnWidth));
      if (column !== announcedColumn) {
        announcedColumn = column;
        counter.textContent = `COLUMN ${number(column + 1)} / ${number(totalColumns)}`;
      }
    };

    const pause = () => { pauseUntil = performance.now() + 8000; };
    const move = (direction: number) => {
      if (columnWidth <= 0 || loopWidth <= 0) return;
      pause();
      const offset = columnsPerClick() * columnWidth;
      let start = viewport.scrollLeft;
      const maximum = viewport.scrollWidth - viewport.clientWidth;
      // Move between identical copies before sliding to avoid a hard stop.
      if (direction < 0 && start < offset) start += loopWidth;
      if (direction > 0 && start + offset > maximum) start -= loopWidth;
      viewport.scrollLeft = start;
      viewport.scrollTo({
        left: start + direction * offset,
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    };
    controls.hidden = false;
    prev.disabled = false;
    next.disabled = false;
    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    // Visitors can pause simply by hovering, touching, focusing or swiping.
    viewport.addEventListener('pointerenter', () => { pointerOver = true; });
    viewport.addEventListener('pointerleave', () => { pointerOver = false; touching = false; });
    viewport.addEventListener('pointerdown', () => { touching = true; pause(); });
    viewport.addEventListener('pointerup', () => { touching = false; pause(); });
    viewport.addEventListener('pointercancel', () => { touching = false; });
    viewport.addEventListener('focusin', () => { hasFocus = true; });
    viewport.addEventListener('focusout', () => { hasFocus = viewport.contains(document.activeElement); });
    viewport.addEventListener('wheel', pause, { passive: true });
    viewport.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
    viewport.addEventListener('scroll', updateCount, { passive: true });
    window.addEventListener('resize', () => measure(true));
    smallScreen.addEventListener('change', () => measure(true));

    const animate = (time: number) => {
      const elapsed = lastTime ? Math.min(0.08, (time - lastTime) / 1000) : 0;
      lastTime = time;
      if (loopWidth > 0 && !reducedMotion.matches && document.visibilityState === 'visible'
          && !pointerOver && !touching && !hasFocus && time >= pauseUntil) {
        // Approximately half the Construction photo-reel speed.
        const pixelsPerSecond = smallScreen.matches ? 25 : 42;
        viewport.scrollLeft += pixelsPerSecond * elapsed;
        if (viewport.scrollLeft >= loopWidth) viewport.scrollLeft -= loopWidth;
        updateCount();
      }
      requestAnimationFrame(animate);
    };
    measure();
    updateCount();
    requestAnimationFrame(animate);
  }
</script>
<style>
  /* Projects photo header matches ANDRO's construction and other photo-led pages. */
  .page-hero.projects-photo-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 52vw, 710px);
    overflow: hidden;
    padding: clamp(105px, 10vw, 150px) 10%;
    background: #343a37;
    color: #fff;
  }
  .projects-hero-image,
  .projects-hero-video {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  .projects-hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .projects-hero-image {
    z-index: -2;
    object-fit: cover;
    object-position: center 45%;
  }
  /* Use the identical crop for the loading frame and the moving video. */
  .projects-hero-video-poster { object-position: center; }
  .projects-hero-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(13,16,15,.78) 0%, rgba(13,16,15,.63) 47%, rgba(13,16,15,.27) 100%),
      linear-gradient(0deg, rgba(13,16,15,.24), transparent 64%);
  }
  .projects-hero-content { position: relative; max-width: 900px; }
  .projects-photo-hero .eyebrow { color: var(--brand-accent-soft); }
  .projects-photo-hero h1 {
    white-space: pre-line;
    max-width: 900px;
    color: #fff;
    font-size: clamp(61px, 8vw, 108px);
    line-height: .97;
    text-wrap: balance;
  }
  .projects-photo-hero .lead {
    max-width: 690px;
    color: rgba(255,255,255,.94);
    font-size: clamp(13px, 1.1vw, 15px);
    line-height: 1.8;
  }
  @media (max-width: 680px) {
    .page-hero.projects-photo-hero { min-height: 580px; padding: 92px 7% 94px; }
    .projects-photo-hero h1 { font-size: clamp(52px, 12vw, 78px); }
    .projects-photo-hero .lead { font-size: 13px; line-height: 1.75; }
    .projects-hero-image { object-position: 55% center; }
    .projects-hero-video-poster { object-position: center; }
    .projects-hero-shade {
      background: linear-gradient(90deg, rgba(13,16,15,.83), rgba(13,16,15,.55)),
                  linear-gradient(0deg, rgba(13,16,15,.2), transparent);
    }
  }

  .andro-projects-gallery-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px 24px; margin: 0 0 24px; }
  .andro-projects-tip { flex: 1 1 320px; margin: 0; color: var(--brand-muted); font-size: 12px; line-height: 1.6; }
  .andro-projects-navigation { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .andro-projects-navigation[hidden] { display: none !important; }
  .andro-projects-count { color: var(--brand-muted); font-size: 11px; letter-spacing: .13em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .andro-projects-navigation-buttons { display: flex; align-items: center; gap: 8px; }
  .andro-gallery-arrow { display: grid; place-items: center; width: 45px; height: 45px; padding: 0; border: 1px solid #b49b70; border-radius: 0; color: #262724; background: transparent; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .andro-gallery-arrow:not(:disabled):hover { background: #262724; color: #fff; }
  .andro-gallery-arrow:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 3px; }
  .andro-gallery-arrow:disabled { opacity: .32; cursor: not-allowed; }
  .andro-gallery-arrow svg { display: block; }
  /* Two rows x five columns. Native horizontal scrolling provides smooth sliding
     and preserves the previous two columns when the next six photos enter. */
  .andro-projects-viewport {
    --project-gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scroll-snap-type: none; /* Avoid snapping during the slow, continuous scroll. */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .andro-projects-viewport::-webkit-scrollbar { display: none; }
  .andro-projects-viewport:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 4px; }
  .andro-projects-grid {
    display: grid;
    position: relative;
    width: 100%;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * var(--project-gap)) / 5);
    gap: var(--project-gap);
  }
  .andro-project-tile { display: block; position: relative; min-width: 0; width: 100%; aspect-ratio: 4 / 3; margin: 0; padding: 0; border: 0; overflow: hidden; background: #d4d0c8; color: #fff; text-align: left; }
  .andro-project-tile img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .andro-project-overlay { display: flex; flex-direction: column; justify-content: end; gap: 7px; position: absolute; inset: 0; padding: clamp(10px, 1.1vw, 18px); background: linear-gradient(180deg, rgba(10,12,11,.17), rgba(10,12,11,.89)); color: #fff; opacity: 1; transform: none; pointer-events: none; overflow: hidden; }
  .andro-project-category { color: #dfcba7; font-size: 10px; line-height: 1.3; letter-spacing: .07em; text-transform: uppercase; }
  .andro-project-title { font-family: var(--font-display); font-size: clamp(15px, 1.35vw, 22px); font-weight: 400; letter-spacing: -.04em; line-height: 1.14; }
  .andro-project-description { color: rgba(255,255,255,.94); font-size: 12px; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  /* Photo titles and descriptions are always visible, without hover or tap. */
  .andro-project-overlay { background: linear-gradient(180deg, transparent 6%, rgba(10,12,11,.32) 45%, rgba(10,12,11,.85) 100%); }
  .projects-note { margin-top: 50px; max-width: 760px; }
  .projects-cta-heading { white-space: pre-line; }
  @media (max-width: 760px) { .andro-projects-gallery-head { align-items: flex-start; } .andro-projects-navigation { margin-left: 0; } .andro-projects-viewport { --project-gap: 12px; } .andro-projects-grid { grid-auto-columns: calc((100% - var(--project-gap)) / 2); } .andro-project-tile { aspect-ratio: 1 / 1.12; } .andro-project-title { font-size: clamp(15px, 3.5vw, 21px); } .andro-project-description { font-size: 11px; line-height: 1.45; } }
  @media (max-width: 420px) { .andro-projects-navigation { width: 100%; justify-content: space-between; } }
  @media (max-width: 400px) { .andro-project-overlay { padding: 10px; gap: 5px; } .andro-project-category { font-size: 9px; } .andro-project-title { font-size: 15px; } .andro-project-description { font-size: 10px; -webkit-line-clamp: 3; } }
  @media (prefers-reduced-motion: reduce) { .andro-project-tile img, .andro-project-overlay { transition: none; } .andro-projects-viewport { scroll-behavior: auto; } }
</style>
