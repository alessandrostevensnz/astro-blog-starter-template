---
import SiteLayout from '../components/SiteLayout.astro';
import { imagery, siteContent } from '../data/site';
---
<SiteLayout title="Property + Asset Maintenance — ANDRO" description={siteContent.maintenance.description}>
  <section class="page-hero"><p class="eyebrow">PROPERTY + ASSET MAINTENANCE</p><h1>Look after<br />what matters.</h1><p class="lead">{siteContent.maintenance.description}</p></section>
  <section class="page-body section-pad"><div class="two-col"><div><p class="eyebrow">CARE FOR YOUR PROPERTY</p><h2>Steady, considered<br />maintenance.</h2></div><div><p class="body-copy">ANDRO provides property and asset maintenance for residential and commercial clients. From individual maintenance requirements to ongoing property care, we take a practical approach and keep communication clear.</p><p class="body-copy">Tell us about the property, the work required and any timing considerations. We can discuss an appropriate scope and next steps.</p><a class="text-link" href="/contact/">Make an enquiry <span>↗</span></a></div></div></section>
  <section class="content-block"><p class="eyebrow">MAINTENANCE SUPPORT</p><h2>Responsive care, with attention to the details.</h2><div class="service-list"><article class="service-item"><span>01</span><h3>Residential property maintenance</h3><b>↗</b><p>Maintenance work to help keep homes and residential properties in good order.</p></article><article class="service-item"><span>02</span><h3>Commercial property maintenance</h3><b>↗</b><p>Practical maintenance support for commercial premises and spaces.</p></article><article class="service-item"><span>03</span><h3>Asset maintenance</h3><b>↗</b><p>Ongoing care and maintenance planning for property assets.</p></article><article class="service-item"><span>04</span><h3>Repairs and improvement work</h3><b>↗</b><p>Discuss repair and improvement requirements with our team to establish a suitable scope.</p></article></div></section>
  <section class="image-band"><img src={siteContent.images.maintenance.src} alt={siteContent.images.maintenance.alt} loading="lazy" /><div class="image-band-copy"><p class="eyebrow inverse">AUCKLAND · NEW ZEALAND</p><h2>Well cared for.<br />Well considered.</h2></div></section>
  <section class="cta-section"><div class="cta-row"><h2>Need a hand<br />with your property?</h2><a class="text-link" href="/contact/">Talk to ANDRO <span>↗</span></a></div></section>
</SiteLayout>
