---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent } from '../data/site';
---
<SiteLayout title="Property + Asset Maintenance — ANDRO" description={siteContent.maintenance.description}>
  <section class="maintenance-hero" aria-labelledby="maintenance-title">
    <img class="maintenance-hero-image" src="/images/preston.png" alt="Property maintenance project in Preston" fetchpriority="high" />
    <div class="maintenance-hero-shade"></div>
    <div class="maintenance-hero-copy">
      <p class="eyebrow inverse">PROPERTY + ASSET MAINTENANCE · AUCKLAND</p>
      <h1 id="maintenance-title">Look after<br />what matters.</h1>
    </div>
  </section>

  <section class="page-body section-pad">
    <div class="two-col">
      <div>
        <p class="eyebrow">CARE FOR YOUR PROPERTY</p>
        <h2>Steady, considered<br />maintenance.</h2>
      </div>
      <div>
        <p class="body-copy">{siteContent.maintenance.description}</p>
        <p class="body-copy">From one-off repairs to ongoing property care, we take time to understand what the building needs and agree a practical way forward. Our aim is to make looking after your property straightforward, with quality workmanship and clear communication throughout.</p>
        <a class="text-link" href="/contact/">Discuss your property <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="content-block">
    <p class="eyebrow">MAINTENANCE SUPPORT</p>
    <h2>Responsive care, with attention to the details.</h2>
    <div class="service-list">
      <article class="service-item"><span>01</span><h3>Building repairs</h3><b aria-hidden="true">↗</b><p>Practical repairs to help keep your property in good working order.</p></article>
      <article class="service-item"><span>02</span><h3>Exterior upkeep</h3><b aria-hidden="true">↗</b><p>Maintenance for exterior elements, including cladding and other building details.</p></article>
      <article class="service-item"><span>03</span><h3>Ongoing property care</h3><b aria-hidden="true">↗</b><p>Dependable support for residential and commercial property maintenance needs.</p></article>
    </div>
  </section>

  <section class="image-band">
    <img src="/images/cladding.png" alt="Exterior cladding on a property" loading="lazy" />
    <div class="image-band-copy"><p class="eyebrow inverse">AUCKLAND PROPERTY CARE</p><h2>Practical support for the places you rely on.</h2><a class="text-link" href="/contact/">Talk to ANDRO <span>↗</span></a></div>
  </section>

  <section class="cta-section"><div class="cta-row"><h2>Need a hand<br />with your property?</h2><a class="text-link" href="/contact/">Talk to ANDRO <span>↗</span></a></div></section>
</SiteLayout>

<style>
  .maintenance-hero {
    min-height: max(580px, min(720px, calc(100svh - 82px)));
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(80px, 12vw, 150px) 10%;
    color: #fff;
    background: #555;
  }
  .maintenance-hero-image, .maintenance-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .maintenance-hero-image { z-index: -2; object-fit: cover; object-position: center 50%; }
  .maintenance-hero-shade { z-index: -1; background: linear-gradient(90deg, rgba(15, 16, 14, .58), rgba(15, 16, 14, .08) 85%), linear-gradient(0deg, rgba(15, 16, 14, .2), transparent 55%); }
  .maintenance-hero-copy { max-width: 900px; }
  .maintenance-hero h1 { margin: 22px 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(68px, 10vw, 136px); font-weight: 300; line-height: .92; letter-spacing: -.085em; }
  @media (max-width: 680px) {
    .maintenance-hero { min-height: 590px; padding: 76px 7%; }
    .maintenance-hero-image { object-position: 58% center; }
    .maintenance-hero h1 { font-size: clamp(62px, 14vw, 92px); }
  }
</style>
