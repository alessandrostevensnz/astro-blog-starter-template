---
import SiteLayout from '../components/SiteLayout.astro';
import { siteContent } from '../data/site';
import optimizedGallery from '../data/project-gallery-optimized.generated.json';
const photos = siteContent.maintenance.photos;
const optimizedPhotos = optimizedGallery as Record<string, { large?: string; hero?: string }>;
const introBackground = optimizedPhotos[photos.introBackground.src];
const services = siteContent.maintenance.services;
---
<SiteLayout title="Property Maintenance Auckland | Residential & Commercial | ANDRO" description={siteContent.maintenance.description}>
  <section class="maintenance-hero" aria-labelledby="maintenance-title">
    <img class="maintenance-hero-image" src={photos.hero.src} alt={photos.hero.alt} fetchpriority="high" />
    <div class="maintenance-hero-shade"></div>
    <div class="maintenance-hero-copy"><p class="eyebrow inverse">PROPERTY + ASSET MAINTENANCE · AUCKLAND</p><h1 id="maintenance-title">Look after<br />what matters.</h1></div>
  </section>

  <section class="page-body section-pad maintenance-intro-band" aria-labelledby="maintenance-intro-title">
    <img
      class="maintenance-intro-image"
      src={introBackground?.hero ?? photos.introBackground.src}
      srcset={introBackground?.hero && introBackground?.large ? `${introBackground.large} 960w, ${introBackground.hero} 1800w` : undefined}
      sizes="100vw"
      alt={photos.introBackground.alt}
      loading="lazy"
      decoding="async"
    />
    <div class="maintenance-intro-shade" aria-hidden="true"></div>
    <div class="two-col maintenance-intro-grid">
      <div class="maintenance-intro-heading">
        <p class="eyebrow inverse">CARE FOR YOUR PROPERTY</p>
        <h2 id="maintenance-intro-title"><span data-style-key="maintenance.introHeading">{siteContent.maintenance.introHeading}</span></h2>
      </div>
      <div class="maintenance-intro-copy">
        <p class="body-copy">{siteContent.maintenance.description}</p>
        <p class="body-copy"><span data-style-key="maintenance.introText">{siteContent.maintenance.introText}</span></p>
        <a class="text-link" href="/contact/">Discuss your property <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="content-block maintenance-detail-block">
    <p class="eyebrow">PLAN AHEAD · RESPOND WITH CARE</p><h2>Maintenance is more than fixing what has failed.</h2>
    <div class="maintenance-detail-grid">
      <article><h3>{siteContent.maintenance.preventativeHeading}</h3><p>{siteContent.maintenance.preventativeText}</p></article>
      <article><h3>{siteContent.maintenance.residentialHeading}</h3><p>{siteContent.maintenance.residentialText}</p></article>
      <article><h3>{siteContent.maintenance.commercialHeading}</h3><p>{siteContent.maintenance.commercialText}</p></article>
      <article><h3>{siteContent.maintenance.assetHeading}</h3><p>{siteContent.maintenance.assetText}</p></article>
      <article><h3>{siteContent.maintenance.improvementsHeading}</h3><p>{siteContent.maintenance.improvementsText}</p></article>
    </div>
  </section>

  <section class="maintenance-services" aria-labelledby="maintenance-services-heading">
    <div class="maintenance-services-heading"><p class="eyebrow">MAINTENANCE SUPPORT</p><h2 id="maintenance-services-heading">Responsive care, with attention to the details.</h2></div>
    <div class="maintenance-services-list">
      {services.map((service, index) => (
        <article class:list={['maintenance-service', { 'maintenance-service-reverse': index % 2 === 1 }]} data-reveal>
          <div class="maintenance-service-copy">
            <span class="maintenance-service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a class="maintenance-quote-link" href="/contact/" aria-label={`Request a quote for ${service.title}`}>Request a Quote <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="maintenance-service-visual">
            {service.image ? (
              <>
                <img src={service.image} alt={service.imageAlt || service.title} loading="lazy" decoding="async" />
                {service.caption && <figcaption>{service.caption}</figcaption>}
              </>
            ) : (
              <div class="service-photo-placeholder" role="img" aria-label={`${service.title} photography placeholder`}>
                <span class="placeholder-mark" aria-hidden="true">ANDRO</span><span>Service photography</span><small>Add an approved project photo in the site editor</small>
              </div>
            )}
          </figure>
        </article>
      ))}
    </div>
  </section>

  <section class="image-band"><img src={photos.closing.src} alt={photos.closing.alt} loading="lazy" /><div class="image-band-copy"><p class="eyebrow inverse">AUCKLAND PROPERTY CARE</p><h2>Practical support for the places you rely on.</h2><a class="text-link" href="/contact/">Talk to ANDRO <span>↗</span></a></div></section>
</SiteLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('service-reveal-ready');
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('service-is-visible');
          currentObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => observer.observe(item));
  }
</script>

<style>

  /* Photo-backed property maintenance introduction, matching the site's other image-led sections. */
  .page-body.maintenance-intro-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(500px, 42vw, 630px);
    padding-top: clamp(72px, 7vw, 100px);
    padding-bottom: clamp(76px, 7vw, 105px);
    background: #424840;
    color: #fff;
  }
  .maintenance-intro-image,
  .maintenance-intro-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .maintenance-intro-image {
    z-index: -2;
    object-fit: cover;
    object-position: center 48%;
  }
  .maintenance-intro-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(12,16,14,.78) 0%, rgba(12,16,14,.67) 46%, rgba(12,16,14,.60) 100%),
      linear-gradient(0deg, rgba(12,16,14,.18), transparent 65%);
  }
  .maintenance-intro-band .maintenance-intro-grid {
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0,1.08fr) minmax(0,.92fr);
    gap: clamp(44px, 6vw, 108px);
    align-items: center;
  }
  .maintenance-intro-heading {
    min-width: 0;
    max-width: 660px;
    margin-inline: auto;
    text-align: center;
  }
  .maintenance-intro-heading .eyebrow {
    margin: 0 0 clamp(24px, 2.7vw, 38px);
    color: var(--brand-accent-soft);
  }
  .maintenance-intro-band .maintenance-intro-heading h2 {
    max-width: 620px;
    margin: 0;
    color: #fff;
    font-size: clamp(37px, 4.45vw, 63px);
    line-height: 1.12;
    letter-spacing: -.07em;
    font-weight: 300;
    text-wrap: balance;
  }
  .maintenance-intro-copy {
    width: 100%;
    max-width: 465px;
    margin-inline: auto;
  }
  .maintenance-intro-band .maintenance-intro-copy .body-copy {
    max-width: 465px;
    margin: 0 0 20px;
    color: rgba(255,255,255,.94);
    font-size: clamp(13px, 1.04vw, 15px);
    line-height: 1.85;
  }
  .maintenance-intro-band .maintenance-intro-copy .text-link {
    margin-top: 2px;
    border-color: var(--brand-accent-soft);
    color: #f1d8a9;
  }
  .maintenance-intro-band .maintenance-intro-copy .text-link span { color: #f1d8a9; }
  .maintenance-intro-band .maintenance-intro-copy .text-link:focus-visible {
    outline: 2px solid #f1d8a9;
    outline-offset: 4px;
  }
  @media (max-width: 900px) {
    .maintenance-intro-band .maintenance-intro-grid {
      grid-template-columns: minmax(0,1fr) minmax(0,1fr);
      gap: clamp(28px,4vw,52px);
    }
    .maintenance-intro-band .maintenance-intro-heading h2 { font-size: clamp(34px,4.8vw,51px); }
  }
  @media (max-width: 680px) {
    .page-body.maintenance-intro-band { min-height: 0; padding: 66px 7% 76px; }
    .maintenance-intro-band .maintenance-intro-grid {
      grid-template-columns: 1fr;
      gap: 34px;
      margin: 0 auto;
    }
    .maintenance-intro-band .maintenance-intro-heading h2 { font-size: clamp(37px,9vw,55px); }
    .maintenance-intro-heading .eyebrow { margin-bottom: 22px; }
    .maintenance-intro-copy { max-width: 540px; }
    .maintenance-intro-band .maintenance-intro-copy .body-copy { font-size: 14px; line-height: 1.78; }
    .maintenance-intro-image { object-position: 57% center; }
    .maintenance-intro-shade { background: rgba(12,16,14,.75); }
  }

  .maintenance-hero { min-height: max(580px, min(720px, calc(100svh - 82px))); position: relative; display: flex; align-items: center; overflow: hidden; isolation: isolate; padding: clamp(80px, 12vw, 150px) 10%; color: #fff; background: #555; }
  .maintenance-hero-image, .maintenance-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .maintenance-hero-image { z-index: -2; object-fit: cover; object-position: center 50%; }
  .maintenance-hero-shade { z-index: -1; background: linear-gradient(90deg, rgba(15,16,14,.58), rgba(15,16,14,.08) 85%), linear-gradient(0deg, rgba(15,16,14,.2), transparent 55%); }
  .maintenance-hero-copy { max-width: 900px; }
  .maintenance-hero h1 { margin: 22px 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(68px,10vw,136px); font-weight: 300; line-height: .92; letter-spacing: -.085em; }
  .maintenance-detail-block h2, .maintenance-services-heading h2 { max-width: 760px; margin: 14px 0 38px; font-family: var(--font-display); font-size: clamp(36px,4.5vw,60px); font-weight: 300; line-height: 1.08; letter-spacing: -.065em; }
  .maintenance-detail-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 34px 8%; }
  .maintenance-detail-grid article { padding-top: 20px; border-top: 1px solid var(--brand-line); }
  .maintenance-detail-grid h3 { margin: 0 0 12px; font-family: var(--font-display); font-size: 24px; font-weight: 400; }
  .maintenance-detail-grid p { margin: 0; color: var(--brand-muted); font-size: 15px; line-height: 1.85; }
  .maintenance-services { padding: 82px 10% 110px; background: var(--brand-paper); }
  .maintenance-services-heading { max-width: 760px; margin: 0 0 56px; }
  .maintenance-services-heading h2 { margin-bottom: 0; }
  .maintenance-services-list { border-top: 1px solid var(--brand-line); }
  .maintenance-service { display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); align-items: center; gap: clamp(34px,7vw,100px); padding: 42px 0; border-bottom: 1px solid var(--brand-line); }
  .maintenance-service-reverse .maintenance-service-copy { order: 2; }
  .maintenance-service-reverse .maintenance-service-visual { order: 1; }
  .maintenance-service-copy { max-width: 580px; }
  .maintenance-service-number { color: var(--brand-accent); font-size: 11px; letter-spacing: .16em; }
  .maintenance-service h3 { margin: 13px 0 15px; font-family: var(--font-display); font-size: clamp(26px,3vw,40px); font-weight: 400; line-height: 1.12; letter-spacing: -.045em; }
  .maintenance-service-copy > p { margin: 0; color: var(--brand-muted); font-size: 15px; line-height: 1.9; }
  .maintenance-quote-link { display: inline-flex; align-items: center; gap: 20px; margin-top: 24px; padding: 0 0 7px; border-bottom: 1px solid var(--brand-accent); color: var(--brand-accent); font-size: 13px; transition: gap .2s ease,color .2s ease; }
  .maintenance-quote-link:hover { gap: 27px; color: var(--brand-ink); }
  .maintenance-quote-link:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 5px; }
  .maintenance-service-visual { position: relative; aspect-ratio: 1.55/1; margin: 0; overflow: hidden; border-radius: 4px; background: var(--brand-stone); }
  .maintenance-service-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .maintenance-service-visual:hover img { transform: scale(1.035); }
  .maintenance-service-visual figcaption { position: absolute; right: 12px; bottom: 12px; left: 12px; padding: 8px 11px; background: rgba(20,20,19,.58); color: #fff; font-size: 12px; }
  .service-photo-placeholder { display:flex; width:100%; height:100%; min-height:210px; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:24px; color:var(--brand-muted); background:linear-gradient(135deg,#e9e5dc,#d9d3c7); text-align:center; }
  .placeholder-mark { color:var(--brand-accent); font-family:var(--font-display); font-size:clamp(30px,4vw,48px); font-weight:300; letter-spacing:.24em; }
  .service-photo-placeholder > span:not(.placeholder-mark) { font-family:var(--font-display); font-size:18px; }
  .service-photo-placeholder small { font-size:12px; line-height:1.5; }
  .service-reveal-ready [data-reveal] { opacity:0; transform:translateY(18px); transition:opacity .65s ease,transform .65s ease; }
  .service-reveal-ready [data-reveal].service-is-visible { opacity:1; transform:translateY(0); }
  @media(max-width:900px) { .maintenance-services { padding-right:7%; padding-left:7%; } .maintenance-service { gap:32px; } }
  @media(max-width:680px) { .maintenance-hero { min-height:590px; padding:76px 7%; } .maintenance-hero-image { object-position:58% center; } .maintenance-hero h1 { font-size:clamp(62px,14vw,92px); } .maintenance-detail-grid { grid-template-columns:1fr; gap:25px; } .maintenance-services { padding:60px 7% 72px; } .maintenance-services-heading { margin-bottom:32px; } .maintenance-service { grid-template-columns:1fr; gap:23px; padding:30px 0; } .maintenance-service-reverse .maintenance-service-copy,.maintenance-service-reverse .maintenance-service-visual { order:initial; } .maintenance-service-visual { aspect-ratio:1.35/1; } }
  @media(prefers-reduced-motion:reduce) { .maintenance-service-visual img,.maintenance-quote-link,.service-reveal-ready [data-reveal] { transition:none; } .service-reveal-ready [data-reveal] { opacity:1; transform:none; } }
</style>
