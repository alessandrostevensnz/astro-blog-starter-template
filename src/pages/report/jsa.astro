---
export const prerender = false;
// Guarded by the existing /report/* password-session middleware.
---
<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#faf9f7" />
  <title>JSA Risk Matrix Reports | ANDRO</title>
  <style is:global>
    :root{font-family:Arial,"Helvetica Neue",sans-serif;color:#262725;background:#faf9f7;font-synthesis:none}
    *{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}body{margin:0}
    button,input,textarea,select{font:inherit}button{cursor:pointer}button,input,textarea,select{max-width:100%}
    [hidden]{display:none!important}a{color:inherit}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid #98794d;outline-offset:3px}
    .mast{background:#fff;border-bottom:1px solid #eae3d8;padding:21px max(18px,calc((100vw - 1140px)/2));display:flex;justify-content:space-between;align-items:center;gap:15px}
    .logo{font-size:28px;letter-spacing:.34em;font-weight:300}.strap{color:#ac8a5c;letter-spacing:.2em;font-size:9px;margin-top:5px}
    .mast a,.back{text-decoration:none;font-size:13px;color:#816642}
    .shell{max-width:1140px;padding:0 20px;margin:30px auto 75px}.intro{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:28px}
    .eyebrow{font-size:10px;font-weight:700;letter-spacing:.18em;color:#a48458;text-transform:uppercase}.intro h1{font-weight:300;letter-spacing:-.045em;font-size:clamp(32px,4.5vw,50px);margin:8px 0 11px;line-height:1.1}
    .subtle{color:#706f69;font-size:14px;line-height:1.65}.muted{color:#77716c}.small{font-size:12px;line-height:1.5}
    .btn{border:1px solid #b79a70;background:#b79a70;color:#fff;border-radius:3px;padding:11px 16px;min-height:43px;text-decoration:none;display:inline-flex;gap:7px;justify-content:center;align-items:center;font-size:13px;font-weight:600}
    .btn.secondary{background:#fff;color:#826840;border-color:#d4c5b0}.btn.ghost{background:transparent;color:#706b64;border-color:#ddd6cd}.btn.danger{background:#fff;color:#9a332f;border-color:#e0c0bb}
    .btn:disabled{opacity:.5;cursor:not-allowed}.buttons{display:flex;gap:9px;flex-wrap:wrap;align-items:center}
    .panel{background:#fff;border:1px solid #e5dfd5;padding:clamp(16px,2.6vw,27px);margin:15px 0;border-radius:4px}
    .panel>h2,.panel-head h2{font-size:20px;font-weight:400;margin:0 0 15px}.panel-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:10px}
    .tile{border:1px solid #e2d9ca;background:#fff;padding:22px;display:flex;flex-direction:column;gap:12px;max-width:540px;text-decoration:none}
    .tile:hover{border-color:#b79a70}.tile strong{font-weight:400;font-size:23px}.tile small{color:#79746a;line-height:1.6}
    .record{border-top:1px solid #e7dfd7;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:17px 0}
    .record strong{display:block;font-weight:600}.record span{display:block;color:#77716c;font-size:12px;margin-top:6px}
    .empty{border:1px dashed #d3c6b8;text-align:center;color:#747069;padding:25px}
    .notice{background:#f7f3eb;border-left:3px solid #b99b69;padding:14px 16px;color:#5e584f;font-size:13px;line-height:1.65;margin:13px 0}
    .toolbar{display:flex;gap:10px;justify-content:space-between;align-items:center;flex-wrap:wrap;margin:0 0 18px}
    .steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:20px}
    .step-tab{min-height:60px;background:#fff;border:1px solid #e5dfd5;text-align:left;padding:10px 12px;color:#6f6a63;font-size:13px}
    .step-tab b{display:block;color:#ac8a5c;font-size:10px;letter-spacing:.1em;margin-bottom:7px}.step-tab[aria-current=step]{border-color:#a98759;background:#f6f0e6;color:#25221e}
    .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px 20px}
    .fields.three{grid-template-columns:repeat(3,minmax(0,1fr))}.full{grid-column:1/-1}
    .field label,.field-label{display:block;font-weight:650;font-size:13px;margin-bottom:6px;color:#31302b;line-height:1.4}
    .field input:not([type=checkbox]):not([type=radio]):not([type=file]),.field select,.field textarea,
    .row-input{display:block;width:100%;border:1px solid #d4cec5;background:white;border-radius:3px;padding:11px;min-height:43px;color:#252722;font-size:15px}
    .field textarea{min-height:94px;resize:vertical;line-height:1.5}.hint{display:block;color:#77736a;font-size:11px;line-height:1.5;margin-top:5px}
    .choices{display:flex;flex-wrap:wrap;gap:10px 20px;padding:7px 0}.choices label{display:inline-flex;gap:8px;align-items:center;min-height:30px;font-weight:400;margin:0;font-size:14px}
    .choices input{width:19px;height:19px;accent-color:#b79a70}.compact{margin:0}.divider{height:1px;background:#ece7df;margin:22px 0}
    .entry{padding:15px;border:1px solid #dfd6ca;background:#fff;margin:13px 0;border-radius:3px}.entry h3{font-weight:600;font-size:16px;margin:0}
    .entry-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}.entry .buttons .btn{padding:7px 10px;min-height:36px;font-size:12px}
    .risk-badge{display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:750;border-radius:3px;min-width:55px;min-height:37px;padding:7px 9px;color:#202020;border:1px solid #d7d1c9;background:#eee}
    .risk-low{background:#21b33c;color:#06220d}.risk-moderate{background:#ffeb39;color:#242214}.risk-high{background:#ff7923;color:#1f1710}.risk-critical{background:#ed2222;color:white}.risk-empty{background:#eeeae3;color:#777}
    .hazard-score-row{display:grid;grid-template-columns:repeat(2, minmax(0,1fr));gap:13px}.risk-result{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:9px;font-size:12px}
    .matrix-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}.matrix{width:100%;border-collapse:collapse;min-width:580px;font-size:12px;text-align:center}
    .matrix th,.matrix td{border:1px solid #c5c1b9;padding:6px}.matrix th{background:#f5f2ec}.matrix input{width:62px;max-width:100%;padding:9px 5px;text-align:center;border:1px solid #7772;background:transparent;font-weight:700;color:inherit}
    .matrix td{transition:background-color .15s}.legend{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0}
    .legend span{padding:7px 10px;font-size:12px;font-weight:650}.repeater{display:flex;flex-direction:column;gap:10px;margin:10px 0}
    .repeater-row{display:grid;grid-template-columns:1.1fr 1fr 1fr auto;gap:10px;align-items:end;padding:12px;background:#faf8f4;border:1px solid #e8e2d8}
    .repeater-row.signature-item{grid-template-columns:minmax(0,1fr) auto}.repeater-row.harness{grid-template-columns:1fr 1fr 1fr auto}
    .signature-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px}.sign-canvas{border:1px dashed #bfb6ab;background:white;width:100%;max-width:540px;height:145px;display:block;touch-action:none;cursor:crosshair}
    .sign-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px}.photo-preview{max-width:220px;max-height:180px;object-fit:contain;display:block;margin-top:12px;border:1px solid #ddd}
    .save-status{color:#627466;font-size:12px;font-weight:600}.tip{font-size:12px;color:#776f66;line-height:1.6}
    .bottom-actions{padding:15px 0 25px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
    .site-footer{max-width:1140px;padding:18px 20px 35px;margin:0 auto;color:#77716c;text-align:center;font-size:11px;letter-spacing:.1em}
    #pdf{display:none}
    @media(max-width:770px){
      .mast{padding:16px}.logo{font-size:23px}.strap{letter-spacing:.09em;font-size:8px}
      .shell{margin:18px auto 38px;padding:0 14px}.panel{padding:17px 14px}.fields,.fields.three{grid-template-columns:1fr}.steps{grid-template-columns:repeat(2,minmax(0,1fr))}
      .step-tab{min-height:57px}.intro h1{font-size:34px}.buttons{width:100%}.buttons .btn{flex:1 1 135px}
      .repeater-row,.repeater-row.harness{grid-template-columns:1fr 1fr}.repeater-row>button{grid-column:1/-1}
      .signature-inputs{grid-template-columns:1fr}.entry{padding:13px}.hazard-score-row{grid-template-columns:1fr}
      .toolbar{align-items:stretch}.toolbar .buttons{width:100%}input,select,textarea{font-size:16px!important}
    }
    @page{size:A4 portrait;margin:13mm 12mm}
    @media print{
      html,body{background:#fff!important;color:#191919!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
      .mast,main,.site-footer{display:none!important}
      #pdf{display:block!important;font:9.2pt/1.48 Arial,Helvetica,sans-serif}
      .pdf-header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #b79a70;padding:0 0 13px;margin-bottom:16px}
      .pdf-brand{font-weight:300;letter-spacing:.27em;font-size:27pt}.pdf-brand-sub{font-size:7pt;color:#a38352;letter-spacing:.11em}
      .pdf-heading{text-align:right}.pdf-heading strong{display:block;font-size:16pt}.pdf-heading span{display:block;font-size:8pt}
      .pdf-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 18px;background:#f8f6f1;padding:12px 14px;border-left:3px solid #b99a70;margin:16px 0}
      .pdf h2{font-size:12pt;border-bottom:1px solid #d6c4aa;color:#765b32;padding:5px 0;margin:18px 0 10px;text-transform:uppercase;letter-spacing:.06em}
      .pdf p{margin:4px 0 9px;overflow-wrap:anywhere;white-space:pre-wrap}.pdf-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 16px}
      .pdf-field{break-inside:avoid;min-width:0}.pdf-field b{display:block;font-size:8.5pt}.pdf-field span{display:block;white-space:pre-wrap;overflow-wrap:anywhere}
      .pdf table{border-collapse:collapse;width:100%;font-size:8pt;table-layout:fixed;margin:8px 0 13px}
      .pdf table th,.pdf table td{border:1px solid #c4c1bb;padding:7px 5px;vertical-align:top;overflow-wrap:anywhere;white-space:pre-wrap}
      .pdf table th{background:#f1eee9;text-align:left}.pdf thead{display:table-header-group}
      .pdf tr{break-inside:avoid;page-break-inside:avoid}.pdf .risk-report-table th,.pdf .risk-report-table td{font-size:7pt;padding:7px 4px}
      .pdf .risk-report-table col:nth-child(1){width:6%}.pdf .risk-report-table col:nth-child(2){width:16%}.pdf .risk-report-table col:nth-child(3){width:15%}
      .pdf .risk-report-table col:nth-child(4){width:9%}.pdf .risk-report-table col:nth-child(5){width:33%}.pdf .risk-report-table col:nth-child(6){width:12%}.pdf .risk-report-table col:nth-child(7){width:9%}
      .pdf .pdf-risk-matrix{max-width:100%;table-layout:fixed}.pdf-risk-matrix th,.pdf-risk-matrix td{text-align:center!important;vertical-align:middle!important;padding:7px 3px!important}
      .pdf-risk-matrix th:first-child{width:25%;text-align:left!important}.pdf-risk-matrix td{font-weight:bold}
      .pdf .risk-low,.pdf .risk-moderate,.pdf .risk-high,.pdf .risk-critical{color:#171717!important}
      .pdf .pdf-sig{display:inline-flex;flex-direction:column;gap:6px;width:45%;min-height:90px;margin:10px 3% 6px 0;break-inside:avoid}
      .pdf .pdf-sig img{max-height:62px;max-width:100%;object-fit:contain;object-position:left bottom}.pdf .pdf-sig .line{border-top:1px solid #888;padding-top:5px}
      .pdf .page-break{break-before:page;page-break-before:always}
      .pdf .pdf-footer{margin:20px 0 0;border-top:1px solid #d7c6ac;padding:8px 0;text-align:center;letter-spacing:.06em;color:#777;font-size:8pt}
      .pdf .matrix-note{font-size:8pt;color:#555}
      .pdf img.permit{max-width:160mm;max-height:88mm;object-fit:contain;border:1px solid #d8d2ca}
    }
  </style>
</head>
<body>
  <header class="mast">
    <div><div class="logo">ANDRO</div><div class="strap">CONSTRUCTION + PROJECTS · EST. 2020</div></div>
    <a href="/report">All site reports</a>
  </header>
  <main id="dashboard" class="shell">
    <div class="intro"><div><div class="eyebrow">04 / SAFETY</div><h1>Job Safety Analysis</h1><p class="subtle">Editable JSA, task-by-task hazard assessment and colour-coded risk matrix.</p></div><button id="new-jsa" class="btn" type="button">+ Create JSA report</button></div>
    <div class="panel">
      <div class="panel-head"><h2>Saved JSA drafts</h2><div class="buttons">
        <button id="export-jsa-backup" class="btn secondary" type="button">Export JSA backup</button>
        <label class="btn secondary" style="margin:0;cursor:pointer">Import backup <input id="import-jsa-backup" type="file" accept=".json,application/json" hidden /></label>
      </div></div>
      <div id="saved-jsas" class="empty">Loading saved JSA reports...</div>
    </div>
    <div class="notice">JSA drafts, signatures and permit photos stay in this browser on this device. They do not automatically sync or email. Export a backup regularly and save a PDF for your records.</div>
  </main>
  <main id="editor" class="shell" hidden>
    <div class="intro">
      <div><div class="eyebrow">ANDRO / JOB SAFETY ANALYSIS</div><h1 id="form-heading">JSA risk assessment</h1><span id="save-status" class="save-status" role="status">Ready</span></div>
      <div class="buttons"><button id="back-dashboard" class="btn secondary" type="button">All JSAs</button><button id="duplicate-jsa" class="btn secondary" type="button">Duplicate</button><button id="save-pdf" class="btn" type="button">Save as PDF</button></div>
    </div>
    <div class="notice">Complete this assessment for the actual site and task. The matrix scores follow your supplied example but are editable. Before any work begins, verify the hazards, controls, residual risks and required approvals with the responsible supervisor and workers.</div>
    <nav class="steps" aria-label="JSA form sections">
      <button type="button" class="step-tab" data-step-tab="0"><b>STEP 01</b>Job information</button>
      <button type="button" class="step-tab" data-step-tab="1"><b>STEP 02</b>Emergency & site checks</button>
      <button type="button" class="step-tab" data-step-tab="2"><b>STEP 03</b>Tasks & risk matrix</button>
      <button type="button" class="step-tab" data-step-tab="3"><b>STEP 04</b>Final checks & sign-off</button>
    </nav>
    <section data-step="0" class="panel">
      <div class="panel-head"><h2>01. Job information</h2><span class="eyebrow">Site and work scope</span></div>
      <div class="fields">
        <div class="field"><label for="prepared">JSA prepared by</label><input id="prepared" data-key="preparedBy" autocomplete="name" placeholder="First and last name" /></div>
        <div class="field"><label for="job-date">Date</label><input id="job-date" type="date" data-key="date" /></div>
        <div class="field"><label for="job-name">Job name / client</label><input id="job-name" data-key="jobName" /></div>
        <div class="field"><label for="job-number">Job number</label><input id="job-number" data-key="jobNumber" /></div>
        <div class="field full"><label for="site">Site / location</label><input id="site" data-key="site" placeholder="Site street address, suburb, town" /></div>
        <div class="field"><label for="branch">Branch / contracting company</label><input id="branch" data-key="branch" placeholder="Optional" /></div>
        <div class="field"><label for="building">Work area / building name</label><input id="building" data-key="building" /></div>
        <div class="field full"><label for="brief">Brief description of work</label><textarea id="brief" data-key="description"></textarea></div>
        <div class="field"><label for="hotworks">Hot works?</label><select id="hotworks" data-key="hotWorks"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field"><label for="activity">Task / activity to be carried out on site</label><input id="activity" data-key="activity" placeholder="e.g. Working at height" /></div>
        <div class="field full"><label for="qualifications">Qualifications / competencies required</label><textarea id="qualifications" data-key="qualifications" placeholder="One per line, e.g. Working at heights, First Aid"></textarea></div>
        <div class="field full"><label for="workdetails">Further details of job</label><textarea id="workdetails" data-key="jobDetails"></textarea></div>
        <div class="field full"><label for="rescue">Rescue plan (site-specific)</label><textarea id="rescue" data-key="rescuePlan" placeholder="Describe rescue arrangements, trained persons, equipment, communications and escalation."></textarea><span class="hint">Review this against the actual site and applicable work procedures before starting work.</span></div>
        <div class="field"><label for="firstaidkit">First aid kit location</label><input id="firstaidkit" data-key="firstAidKit" /></div>
        <div class="field"><label for="firstaiders">First aiders on site</label><textarea id="firstaiders" data-key="firstAiders" placeholder="Enter one name per line"></textarea></div>
      </div>
    </section>
    <section data-step="1" class="panel" hidden>
      <div class="panel-head"><h2>02. Emergency planning and site checks</h2><span class="eyebrow">Before the job</span></div>
      <div class="fields">
        <div class="field full"><label for="evac">Evacuation route</label><textarea id="evac" data-key="evacuationRoute"></textarea></div>
        <div class="field"><label for="assembly">Emergency assembly point</label><input id="assembly" data-key="assemblyPoint" /></div>
        <div class="field"><label for="exclusion">Exclusion zone required?</label><select id="exclusion" data-key="exclusionZone"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field full"><span class="field-label">PPE required on site</span><div class="choices" id="ppe-choices"></div><input data-key="ppeOther" placeholder="Additional PPE, separated by commas" aria-label="Additional PPE" /></div>
        <div class="field full"><label for="site-regs">Site-specific regulations / induction requirements</label><textarea id="site-regs" data-key="siteRegulations"></textarea></div>
        <div class="field"><label for="environment">Environmental impact?</label><select id="environment" data-key="environment"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field"><label for="chemicals">Chemicals used on site?</label><select id="chemicals" data-key="chemicals"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field"><label for="equipment">Equipment fit for purpose?</label><select id="equipment" data-key="equipmentFit"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field"><label for="buddy">Buddy checks completed before work?</label><select id="buddy" data-key="buddyChecks"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field full"><label for="additional">Additional site hazards / emergency arrangements</label><textarea id="additional" data-key="siteNotes"></textarea></div>
      </div>
    </section>
    <section data-step="2" class="panel" hidden>
      <div class="panel-head"><h2>03. Steps taken to carry out task</h2><button class="btn secondary" type="button" id="add-hazard">+ Add task / hazard</button></div>
      <p class="subtle">Add each task and hazard, assess the initial risk, record controls and the person responsible, then reassess the residual risk after those controls. All text, risk inputs and matrix values can be changed.</p>
      <div id="hazard-rows"></div>
      <div class="divider"></div>
      <div class="panel-head"><h2>Editable 5×5 risk matrix</h2><button id="reset-matrix" class="btn ghost" type="button">Reset to reference matrix</button></div>
      <p class="tip">The starting 1–25 ratings match the example PDF. Tap any number to edit the matrix for your approved site procedure. Hazard scores recalculate from the currently selected likelihood and consequence.</p>
      <div class="matrix-scroll"><table class="matrix" aria-label="Editable risk rating matrix"><thead><tr><th scope="col">Likelihood / impact</th><th>Insignificant</th><th>Minor</th><th>Moderate</th><th>Major</th><th>Severe</th></tr></thead><tbody id="matrix-inputs"></tbody></table></div>
      <div class="legend"><span class="risk-low">1–7 Low</span><span class="risk-moderate">8–12 Moderate</span><span class="risk-high">13–19 High</span><span class="risk-critical">20–25 Critical</span></div>
      <div class="field"><label for="matrix-notes">Risk criteria / company procedure notes</label><textarea id="matrix-notes" data-key="matrixNotes" placeholder="Describe the applicable scoring policy, consequence definitions and acceptance criteria."></textarea></div>
    </section>
    <section data-step="3" class="panel" hidden>
      <div class="panel-head"><h2>04. Final checks and sign-off</h2><span class="eyebrow">Confirm with site team</span></div>
      <div class="fields">
        <div class="field full"><span class="field-label">Final checks — equipment suitable for task</span><div id="final-check-choices" class="choices"></div></div>
        <div class="field"><label for="trained">Are you trained and competent for the work?</label><select id="trained" data-key="trainedCompetent"><option value="">Select</option><option>Yes</option><option>No</option></select></div>
        <div class="field"><label for="fall">Using rope access / fall arrest equipment?</label><select id="fall" data-key="fallArrest"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
      </div>
      <div class="divider"></div>
      <div class="panel-head"><h2>Rope / fall-arrest equipment checks</h2><button id="add-harness" class="btn secondary" type="button">+ Add equipment check</button></div>
      <p class="tip">Record name/user, fit for purpose and harness tag expiry for each applicable item.</p>
      <div id="harness-rows" class="repeater"></div>
      <div class="divider"></div>
      <div class="fields"><div class="field"><label for="tags">Electrical equipment has an in-date tag?</label><select id="tags" data-key="electricalTags"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div></div>
      <div class="divider"></div>
      <div class="panel-head"><h2>All team members on site</h2><button id="add-member" class="btn secondary" type="button">+ Add team member</button></div>
      <div id="member-rows" class="repeater"></div>
      <div class="divider"></div>
      <div class="panel-head"><h2>Signatures</h2><button id="add-signature" class="btn secondary" type="button">+ Add signatory</button></div>
      <p class="subtle">Each person signs to confirm they have reviewed and understood the safety requirements and will follow the controls in this JSA. Sign directly with a finger, mouse or stylus.</p>
      <div id="signature-rows" class="repeater"></div>
      <div class="divider"></div>
      <div class="fields">
        <div class="field"><label for="supervisor">Site supervisor</label><input id="supervisor" data-key="supervisor" /></div>
        <div class="field"><label for="allocator">Who allocated the work?</label><input id="allocator" data-key="allocatedBy" /></div>
        <div class="field"><label for="worksafe">Does WorkSafe need to be notified?</label><select id="worksafe" data-key="workSafe"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field"><label for="permit">Work permit required?</label><select id="permit" data-key="permitRequired"><option value="">Select</option><option>Yes</option><option>No</option><option>N/A</option></select></div>
        <div class="field full"><label for="permitphoto">Photo of permit (optional)</label><input id="permitphoto" type="file" accept="image/*" capture="environment" /><img id="permit-preview" class="photo-preview" alt="Attached permit preview" hidden/><button id="clear-permit" class="btn ghost" type="button" hidden>Remove permit photo</button></div>
        <div class="field full"><span class="field-label">Weather conditions</span><div id="weather-choices" class="choices"></div></div>
        <div class="field full"><label for="weather-other">Other weather conditions</label><input id="weather-other" data-key="weatherOther" placeholder="Specify other conditions, if selected" /></div>
        <div class="field"><label for="sendcopy">Send me a copy (email)</label><input type="email" id="sendcopy" data-key="copyEmail" placeholder="Email for draft recipient" /></div>
        <div class="field"><label for="relaunch">Someone else to relaunch this JSA tomorrow?</label><select id="relaunch" data-key="relaunchTomorrow"><option value="">Select</option><option>Yes</option><option>No</option></select></div>
        <div class="field"><label for="relaunchEmail">Relaunch recipient email</label><input id="relaunchEmail" type="email" data-key="relaunchEmail" /></div>
        <div class="field"><label for="extraEmails">Additional recipients</label><textarea id="extraEmails" data-key="additionalRecipients" placeholder="One email per line"></textarea></div>
        <div class="field full"><label for="finalNotes">Additional controls, limitations or supervisor notes</label><textarea id="finalNotes" data-key="finalNotes"></textarea></div>
      </div>
      <p class="notice">The email fields are recorded in the PDF. They do not automatically send or schedule emails. Use the separate email-draft button after saving the PDF. The selected notifications and permits must be handled through the appropriate external process.</p>
    </section>
    <div class="bottom-actions">
      <div class="buttons"><button id="prev-step" class="btn secondary" type="button">Previous</button><button id="next-step" class="btn secondary" type="button">Next section</button></div>
      <div class="buttons"><button id="email-jsa" class="btn secondary" type="button">Create email draft</button><button id="delete-jsa" class="btn danger" type="button">Delete JSA</button><button id="print-jsa-bottom" class="btn" type="button">Save as PDF</button></div>
    </div>
  </main>
  <div id="pdf" class="pdf" aria-hidden="true"></div>
  <footer class="site-footer">ANDRO CONSTRUCTION LIMITED · ANDRO.CO.NZ · EST. 2020</footer>
  <script is:inline src="/report/jsa-app.js" defer></script>
</body>
</html>