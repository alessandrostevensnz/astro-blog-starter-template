---
export const prerender = false;
import { checkPassword, configured, issueSession, COOKIE } from '../../lib/report-auth';
const env = (Astro.locals as any).runtime?.env ?? {};
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (configured(env) && await checkPassword(password, env.REPORT_PASSWORD)) {
    const session = await issueSession(env.REPORT_SESSION_SECRET);
    Astro.cookies.set(COOKIE, session, { httpOnly: true, secure: true, sameSite: 'strict', path: '/report', maxAge: 8 * 60 * 60 });
    return Astro.redirect('/report', 303);
  }
  error = 'Incorrect password.';
}
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>ANDRO | Report Login</title>
<style>body{font-family:Arial,sans-serif;background:#faf9f7;color:#222;min-height:100vh;display:grid;place-items:center;margin:0;padding:20px}main{width:min(100%,390px);background:white;padding:35px;border:1px solid #e8e0d5}h1{font-weight:300;letter-spacing:.28em}label{display:block;margin:25px 0 8px}input,button{font:inherit;width:100%;box-sizing:border-box;padding:14px}input{border:1px solid #cfc7bb}button{background:#b99d70;color:#fff;border:0;margin-top:15px;cursor:pointer}.error{color:#a12b25}</style></head>
<body><main><h1>ANDRO</h1><p>Site Reports — private access</p><form method="POST"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus /><button type="submit">Sign in</button></form>{error && <p class="error" role="alert">{error}</p>}</main></body></html>
