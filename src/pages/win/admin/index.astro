---
export const prerender = false;
import { winState, nzDate } from '../../../lib/win';
const env = (Astro.locals as any).runtime?.env ?? {};
const campaign = winState(env);
const openTime = typeof env.WIN_OPEN_AT === 'string' && Number.isFinite(Date.parse(env.WIN_OPEN_AT)) ? env.WIN_OPEN_AT : undefined;
const closeTime = typeof env.WIN_CLOSE_AT === 'string' && Number.isFinite(Date.parse(env.WIN_CLOSE_AT)) ? env.WIN_CLOSE_AT : undefined;
const drawTime = typeof env.WIN_DRAW_AT === 'string' && Number.isFinite(Date.parse(env.WIN_DRAW_AT)) ? env.WIN_DRAW_AT : undefined;
let entries: any[] = [];
let total = 0, marketing = 0, winner: any = null;
let error = '';
try {
  if (env.WIN_DB?.prepare) {
    const [rows, stat, chosen] = await Promise.all([
      env.WIN_DB.prepare('SELECT id, created_at, full_name, email, phone, suburb, property_role, service_type, work_details, marketing_opt_in, status, selected_at FROM win_entries ORDER BY created_at DESC LIMIT 250').all(),
      env.WIN_DB.prepare('SELECT count(*) as total, coalesce(sum(marketing_opt_in),0) as marketing FROM win_entries').first(),
      env.WIN_DB.prepare("SELECT id, full_name, email, phone, suburb, service_type, work_details, selected_at FROM win_entries WHERE status = 'winner' LIMIT 1").first(),
    ]);
    entries = rows.results || [];
    total = stat?.total || 0;
    marketing = stat?.marketing || 0;
    winner = chosen;
  } else error = 'D1 database is not bound to this Worker.';
} catch { error = 'Database not ready. Apply the giveaway migration.'; }
// Migration 0002 provides a permanent record of draws and exclusions.
let excludedIds: string[] = [];
let auditEvents: any[] = [];
let auditReady = false;
let eligibleCount = 0;
try {
  if (env.WIN_DB?.prepare) {
    const [exclusions, history, remaining] = await Promise.all([
      env.WIN_DB.prepare('SELECT entry_id FROM win_entry_exclusions').all(),
      env.WIN_DB.prepare('SELECT a.event_type, a.recorded_at, a.reason, e.full_name FROM win_draw_events a JOIN win_entries e ON e.id = a.entry_id ORDER BY a.recorded_at DESC LIMIT 100').all(),
      env.WIN_DB.prepare("SELECT count(*) AS n FROM win_entries e WHERE e.status='valid' AND NOT EXISTS (SELECT 1 FROM win_entry_exclusions x WHERE x.entry_id = e.id)").first(),
    ]);
    excludedIds = (exclusions.results || []).map((e: any) => e.entry_id);
    auditEvents = history.results || [];
    eligibleCount = Number(remaining?.n ?? 0);
    auditReady = true;
  }
} catch {
  if (!error) error = 'Draw-audit tables are missing. Prepare the database below before opening the giveaway.';
}
// The Facebook bridge has its own optional migration. Missing tables never
// interrupt the existing website-entry dashboard or the Christmas draw.
let metaImportReady = false;
let metaAccepted = 0, metaDuplicates = 0, metaRejected = 0;
let metaEntryIds: string[] = [];
let metaEntryForms: Record<string, string> = {};
try {
  if (env.WIN_DB?.prepare) {
    const [counts, ids] = await Promise.all([
      env.WIN_DB.prepare("SELECT status, count(*) AS n FROM win_meta_leads GROUP BY status").all(),
      env.WIN_DB.prepare("SELECT entry_id, form_id FROM win_meta_leads WHERE status='accepted'").all(),
    ]);
    for (const row of counts.results || []) {
      if (row.status === 'accepted') metaAccepted = Number(row.n);
      if (row.status === 'duplicate') metaDuplicates = Number(row.n);
      if (row.status === 'rejected') metaRejected = Number(row.n);
    }
    metaEntryIds = (ids.results || []).map((r: any) => r.entry_id);
    metaEntryForms = Object.fromEntries((ids.results || []).map((r: any) => [r.entry_id, r.form_id]));
    metaImportReady = true;
  }
} catch { /* Meta migration 0003 is optional and not active yet. */ }
// V3 insights use every accepted, non-excluded V3 entry, not just the latest 250.
const v3FormId = String(env.WIN_META_SHEETS_V3_FORM_ID || '');
let v3Rows: any[] = [];
let v3Ready = false;
try {
  if (v3FormId && metaImportReady && auditReady) {
    const r = await env.WIN_DB.prepare("SELECT e.service_type,e.work_details,e.marketing_opt_in,count(*) AS n FROM win_entries e JOIN win_meta_leads m ON m.entry_id=e.id AND m.status='accepted' WHERE m.form_id=? AND NOT EXISTS (SELECT 1 FROM win_entry_exclusions x WHERE x.entry_id=e.id) GROUP BY e.service_type,e.work_details,e.marketing_opt_in").bind(v3FormId).all();
    v3Rows = r.results || []; v3Ready = true;
  }
} catch {}
const v3Total = v3Rows.reduce((n,r)=>n+Number(r.n),0);
const v3Marketing = v3Rows.reduce((n,r)=>n+(Number(r.marketing_opt_in)===1?Number(r.n):0),0);
const v3Prospects = v3Rows.reduce((n,r)=>n+((r.work_details==='Yes'||r.work_details==='Maybe')&&Number(r.marketing_opt_in)===1?Number(r.n):0),0);
function v3Group(field: 'service_type'|'work_details') {
  const counts = new Map<string,number>();
  for(const r of v3Rows){const k=String(r[field]||'Not answered'); counts.set(k,(counts.get(k)||0)+Number(r.n));}
  return [...counts.entries()].sort((a,b)=>b[1]-a[1]);
}
const isV3Entry = (id:string)=>Boolean(v3FormId && metaEntryForms[id]===v3FormId);
const canReview = campaign.phase === 'closed' && auditReady;
const canDraw = canReview && !!campaign.drawAt && Date.now() >= Date.parse(campaign.drawAt) && eligibleCount > 0 && !winner;
---
<!doctype html>
<html lang="en-NZ"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>ANDRO | Giveaway Entries</title>
<style>.record[hidden]{display:none!important}.v3-breakdowns{display:grid;grid-template-columns:1fr 1fr;gap:28px}.v3-row{display:grid;grid-template-columns:1fr auto;gap:4px 12px;margin:12px 0}.v3-bar{grid-column:1/-1;background:#eee9df;height:7px}.v3-bar span{display:block;height:100%;background:#a88b5b}#v3-filter{padding:10px;background:white;border:1px solid #ccc7be}@media(max-width:670px){.v3-breakdowns{grid-template-columns:1fr}}.admin-tabs{display:flex;flex-wrap:wrap;gap:12px 22px;background:#fff;border-bottom:1px solid #e1dbd0;padding:14px max(5vw,20px);font:13px/1.5 Arial,sans-serif}.admin-tabs a{color:#6e5735;text-decoration:none}.admin-tabs a[aria-current="page"]{color:#252723;font-weight:700;border-bottom:1px solid #bda67e}*,*:before,*:after{box-sizing:border-box}body{margin:0;font:14px/1.6 Arial,sans-serif;background:#f6f4f0;color:#272823}header{background:#262923;color:#fff;padding:24px max(20px,calc((100vw - 1220px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.brand{font-size:26px;letter-spacing:.28em}.strap{display:block;font-size:9px;letter-spacing:.15em;color:#c3a77b}main{max-width:1220px;margin:42px auto;padding:0 20px}h1{font-size:42px;font-weight:300;letter-spacing:-.055em;margin:0 0 10px}h2{font-size:21px;font-weight:400}.muted{color:#777168}.eyebrow{color:#94794e;font-size:11px;letter-spacing:.13em}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:30px 0}.stat,.panel{background:#fff;border:1px solid #e5ded2;padding:23px}.stat strong{display:block;font-size:35px;font-weight:300}.stat small{color:#766f66}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:13px;flex-wrap:wrap;margin-bottom:16px}.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}button,.btn{display:inline-flex;justify-content:center;align-items:center;border:1px solid #cfc4b4;color:#282923;background:#fff;padding:11px 15px;min-height:42px;font:inherit;text-decoration:none;cursor:pointer}.primary{background:#262923;border-color:#262923;color:white}button:disabled{opacity:.5;cursor:not-allowed}.notice{background:#f5efe2;padding:15px;margin:20px 0;border-left:3px solid #ad8f5b}.winner{border-left:4px solid #a48b58;padding:18px;margin:20px 0;background:white}.exclusion{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:12px}.exclusion select{max-width:340px;padding:9px;border:1px solid #d7cec0;background:white}.audit-log{margin-top:22px}.audit-log li{padding:8px 0;border-bottom:1px solid #e6e2d9}.record{border-top:1px solid #e8e2d9;padding:20px 0;display:grid;grid-template-columns:1fr 1fr;gap:15px 30px}.record h3{font-size:18px;margin:0 0 5px}.record p{margin:5px 0}.record .description{grid-column:1/-1;white-space:pre-wrap;overflow-wrap:anywhere}.record a{text-decoration:underline}.empty{padding:30px;color:#6f6961;text-align:center}.error{color:#a12b25}.search{padding:11px 14px;min-height:42px;border:1px solid #ccc7be;width:min(100%,310px);font-size:16px}@media(max-width:670px){h1{font-size:34px}.stats{grid-template-columns:1fr 1fr}.stats>.stat:last-child{grid-column:1/-1}.record{grid-template-columns:1fr}.record .description{grid-column:auto}header{padding:20px}main{margin-top:25px}.stat,.panel{padding:17px}}</style></head>
<body><header><div><div class="brand">ANDRO</div><span class="strap">CONSTRUCTION + PROJECTS / PRIVATE GIVEAWAY DASHBOARD</span></div><form action="/api/win/admin/logout" method="POST"><button type="submit">Sign out of dashboards</button></form></header>
<div class="admin-tabs" aria-label="Admin navigation"><a href="/admin/">Admin home</a><a href="/admin/?view=editor">Website editor</a><a href="/analytics">Analytics</a><a href="/win/admin" aria-current="page">Win a Day admin</a></div>
<main>
  <p class="eyebrow">COMPETITION CONTROL CENTRE</p><h1>Giveaway entries.</h1><p class="muted">Review submissions, export entries and conduct the draw. This area is protected and is not visible to visitors.</p>
  <div class="stats"><div class="stat"><small>Total entries</small><strong>{total}</strong></div><div class="stat"><small>Marketing opt-ins</small><strong>{marketing}</strong></div><div class="stat"><small>Competition status</small><strong style="font-size:24px;text-transform:capitalize">{campaign.phase}</strong></div></div>
  <p class="muted">Eligible entries after documented exclusions: {auditReady ? eligibleCount : 'Audit migration required'}. A provisional selection is not a confirmed winner until eligibility is checked.</p>
  <p class="muted">Facebook Instant Form integration: <strong>{env.WIN_META_IMPORT_ENABLED === 'true' ? 'Import enabled — verify Meta Page/form permissions and test lead' : 'Not connected — website entries continue normally'}</strong>.
    {metaImportReady && <> Facebook accepted: {metaAccepted}, duplicates: {metaDuplicates}, incomplete/rejected: {metaRejected}.</>}
    {!metaImportReady && <> Facebook import database not installed (optional migration 0003).</>}
  </p>
  <p class="muted">Sheets connection configuration:
    shared secret {typeof env.WIN_META_SHEETS_SYNC_SECRET === 'string' && env.WIN_META_SHEETS_SYNC_SECRET.length >= 32 ? 'configured' : 'missing or too short'} ·
    original form ID {/^[0-9]{5,25}$/.test(String(env.WIN_META_FORM_ID || '')) ? 'configured' : 'missing or invalid'} ·
    V2 form ID {/^[0-9]{5,25}$/.test(String(env.WIN_META_SHEETS_V2_FORM_ID || '')) && env.WIN_META_SHEETS_V2_FORM_ID !== env.WIN_META_FORM_ID ? 'configured' : 'not configured'} ·
    V3 form ID {v3FormId === '2055955115103853' ? 'configured' : 'not configured'} ·
    database {auditReady && metaImportReady ? 'ready' : 'not ready'} ·
    import switches {env.WIN_META_IMPORT_ENABLED === 'true' && env.WIN_META_SHEETS_SYNC_ENABLED === 'true' ? 'on' : 'off'}.
    No secret values are displayed.
  </p>
  {error && <div class="notice error" role="alert">{error}</div>}
  {!auditReady && typeof env.WIN_DB?.prepare === 'function' && <form method="POST" action="/api/win/admin/setup" class="notice">
    <strong>One-time setup required before entries can open.</strong>
    <p>This securely creates the two missing draw-audit tables in the existing ANDRO Cloudflare database. No competition entries are changed or removed.</p>
    <button class="primary" type="submit">Prepare draw database</button>
  </form>}
  {openTime && closeTime && drawTime && <p class="notice">Scheduled entries open: {nzDate(openTime)}. Entries close at midnight at the end of Thursday 24 December 2026 (00:00 on Friday 25 December). Christmas Day winner draw: {nzDate(drawTime)}. The draw is manual; the Draw winner button becomes available after the scheduled time when entries have closed.</p>}
  {winner ? <div class="winner"><p class="eyebrow">PROVISIONALLY SELECTED ENTRANT</p><h2>{winner.full_name}</h2><p>{winner.email}{winner.phone ? ` · ${winner.phone}` : ''} · {winner.suburb}</p><p>{winner.service_type || 'Work category to be confirmed'}{winner.work_details ? ` — ${winner.work_details}` : ' — No work description provided'}</p><p class="muted">Selected: {winner.selected_at ? nzDate(winner.selected_at) : 'Date unavailable'}. Check eligibility and owner permission. If this entrant declines, fails the published eligibility terms, or does not respond within seven days of first contact, record the reason below to permit a replacement draw.</p>
  {canReview && <form class="exclusion" method="POST" action="/api/win/admin/exclude" data-confirm-exclusion>
    <input type="hidden" name="entry_id" value={winner.id} />
    <label for="winner-reason">Exclude this provisional selection:</label>
    <select id="winner-reason" name="reason" required>
      <option value="">Choose a documented reason</option>
      <option>Selected entrant declined the prize</option>
      <option>Selected entrant did not respond within seven days</option>
      <option>Entrant under 18 or without property authority</option>
      <option>ANDRO promoter, employee or immediate family</option>
      <option>Outside advertised Auckland area</option>
      <option>Duplicate entry</option>
      <option>Inaccurate or fraudulent entry</option>
      <option>Unlawful or unsafe work scope with no suitable alternative</option>
    </select>
    <button type="submit">Record exclusion and allow redraw</button>
  </form>}</div> : <div class="notice">{canDraw ? 'Eligible entries are ready for the documented random draw.' : 'The winner draw unlocks after the scheduled time, once the entry period is closed, migration 0002 has been applied and at least one eligible entry remains.'}</div>}
  <section class="panel" style="margin:24px 0">
    <p class="eyebrow">CONSTRUCTION V3 / FACEBOOK INSTANT FORM</p><h2>Construction enquiries &amp; future projects</h2>
    {!v3Ready ? <p class="muted">V3 analytics is not available yet. Check the form configuration and database.</p> : <>
      <div class="stats"><div class="stat"><small>V3 entries (excluding exclusions)</small><strong>{v3Total}</strong></div><div class="stat"><small>Marketing opt-ins</small><strong>{v3Marketing}{v3Total>0?' / '+v3Total:''}</strong><small>{v3Total?Math.round(100*v3Marketing/v3Total)+'%':'—'}</small></div><div class="stat"><small>Yes / Maybe + email opt-in</small><strong>{v3Prospects}</strong></div></div>
      <div class="v3-breakdowns">{([['Requested construction work',v3Group('service_type')],['Larger projects within 12 months',v3Group('work_details')]] as [string,[string,number][]][]).map(([title,rows])=><div><h2>{title}</h2>{rows.length?rows.map(([label,n])=><div class="v3-row"><span>{label}</span><b>{n}</b><div class="v3-bar"><span style={'width:'+100*n/Math.max(1,v3Total)+'%'}></span></div></div>):<p class="muted">No V3 entries yet.</p>}</div>)}</div>
      <p class="muted">Project interest alone is not permission to contact someone for marketing. Only separate email opt-ins qualify; answers do not affect the draw.</p>
    </>}
  </section>
  <div class="toolbar"><h2>Recent entries <small class="muted">(latest 250)</small></h2><div class="actions"><input id="search" class="search" aria-label="Search loaded entries" placeholder="Search entries…" /><select id="v3-filter" aria-label="Filter entries"><option value="all">All entries</option><option value="v3">Construction V3</option><option value="prospect">V3 Yes / Maybe + opt-in</option><option value="marketing">Marketing opted in</option></select><a class="btn" href="/api/win/admin/export">Export all entries (CSV)</a>{canDraw && <form id="draw-form" method="POST" action="/api/win/admin/draw"><button class="primary" type="submit">Draw winner</button></form>}</div></div>
  <div class="panel" id="entries">{entries.length === 0 ? <p class="empty">No entries yet.</p> : entries.map((entry) => <article class="record" data-v3={isV3Entry(entry.id)?'1':'0'} data-marketing={Number(entry.marketing_opt_in)===1?'1':'0'} data-prospect={isV3Entry(entry.id)&&!excludedIds.includes(entry.id)&&Number(entry.marketing_opt_in)===1&&['Yes','Maybe'].includes(entry.work_details)?'1':'0'} data-search={(entry.full_name+' '+entry.email+' '+entry.suburb+' '+entry.service_type+' '+entry.work_details).toLowerCase()}><div><h3>{entry.full_name}</h3><p><a href={'mailto:'+entry.email}>{entry.email}</a></p>{entry.phone && <p><a href={'tel:'+entry.phone}>{entry.phone}</a></p>}<p class="muted">{entry.suburb || 'Auckland eligibility to verify'} · {entry.property_role || 'Property authority to verify'}</p></div><div><p><strong>{entry.service_type || 'Work category not collected (Facebook)'}</strong></p><p class="muted">{nzDate(entry.created_at)}</p><p>Source: {metaEntryIds.includes(entry.id) ? (isV3Entry(entry.id)?'Facebook Instant Form — Construction V3':'Facebook Instant Form') : 'ANDRO website'}</p><p>Marketing: {entry.marketing_opt_in ? 'Opted in' : (metaEntryForms[entry.id] && metaEntryForms[entry.id] === String(env.WIN_META_FORM_ID) ? 'Not collected (original Facebook form)' : 'Not opted in')}</p><p>Status: {excludedIds.includes(entry.id) ? 'Excluded from draw' : entry.status}</p></div><p class="description">{isV3Entry(entry.id) ? "Larger projects in next 12 months: "+(entry.work_details||"Not answered") : (entry.work_details || "No work description provided")}</p>
  {canReview && !excludedIds.includes(entry.id) && entry.status === 'valid' && <form class="exclusion" method="POST" action="/api/win/admin/exclude" data-confirm-exclusion>
    <input type="hidden" name="entry_id" value={entry.id} />
    <label>Exclude an invalid or duplicate entry:
      <select name="reason" required>
        <option value="">Choose a reason</option>
        <option>Duplicate entry</option>
        <option>Outside advertised Auckland area</option>
        <option>Entrant under 18 or without property authority</option>
        <option>ANDRO promoter, employee or immediate family</option>
        <option>Inaccurate or fraudulent entry</option>
      </select>
    </label>
    <button type="submit">Record exclusion</button>
  </form>}
</article>)}</div>
  <section class="panel audit-log"><h2>Draw and eligibility audit</h2><p class="muted">Keep records of the random selection and every reason for exclusion. Do not announce a winner before checking eligibility.</p>
    {auditEvents.length ? <ol>{auditEvents.map(event => <li><strong>{event.event_type === 'selected' ? 'Random selection' : 'Exclusion'}</strong>: {event.full_name} — {nzDate(event.recorded_at)}{event.reason ? ' — '+event.reason : ''}</li>)}</ol> : <p>No recorded draw events yet.</p>}
  </section>
</main>
<script>
const search = document.querySelector<HTMLInputElement>('#search');
const filter = document.querySelector<HTMLSelectElement>('#v3-filter');
const applyFilters = () => {
  const q = (search?.value || '').trim().toLowerCase();
  const f = filter?.value || 'all';
  document.querySelectorAll<HTMLElement>('[data-search]').forEach(node => {
    const match = f==='all'||(f==='v3'&&node.dataset.v3==='1')||(f==='prospect'&&node.dataset.prospect==='1')||(f==='marketing'&&node.dataset.marketing==='1');
    node.hidden = !match || !node.dataset.search?.includes(q);
  });
};
search?.addEventListener('input',applyFilters);filter?.addEventListener('change',applyFilters);
document.querySelector('#draw-form')?.addEventListener('submit', event => { if (!window.confirm('Draw one random winner now? This cannot be undone from this dashboard.')) event.preventDefault(); });
document.querySelectorAll<HTMLFormElement>('[data-confirm-exclusion]').forEach(form => form.addEventListener('submit', event => {
  if (!window.confirm('Permanently exclude this entry from this giveaway? You must have checked the reason and retained supporting evidence. This action is logged.')) event.preventDefault();
}));
</script></body></html>