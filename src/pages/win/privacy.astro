---
/** Public privacy notice for both the website form and any future, approved
 * Meta Instant Form. This reads the same editable source as the /win terms. */
import SiteLayout from '../../components/SiteLayout.astro';
import winCopy from '../../../content/pages/win.json';
const env = (Astro.locals as any).runtime?.env ?? {};
const address = typeof env.WIN_BUSINESS_POSTAL_ADDRESS === 'string' &&
  env.WIN_BUSINESS_POSTAL_ADDRESS.trim().toLowerCase() !== 'pending'
  ? env.WIN_BUSINESS_POSTAL_ADDRESS.trim() : '';
---
<SiteLayout title="ANDRO Giveaway | Privacy Notice" description="ANDRO's personal information collection, competition administration and marketing consent notice.">
  <main class="win-privacy">
    <div class="shell">
      <p class="kicker">ANDRO / CHRISTMAS GIVEAWAY</p>
      <h1>Privacy notice.</h1>
      <p>{winCopy.privacy}</p>
      <p><strong>Promoter and collecting agency:</strong> Andro Construction Limited, trading as ANDRO Construction + Projects.</p>
      {address && <p><strong>Business correspondence address:</strong> {address}</p>}
      <p>For access, correction, consent withdrawal or other privacy enquiries, please <a href="/contact/">contact ANDRO</a>.</p>
      <p><a href="/win/#win-terms">Read the full giveaway conditions</a></p>
    </div>
  </main>
</SiteLayout>
<style>
.win-privacy{background:#f7f6f2;color:#242522;padding:clamp(80px,10vw,150px) 24px}
.win-privacy .shell{max-width:850px;margin:0 auto}
.kicker{font:600 12px/1.4 Arial,sans-serif;letter-spacing:.2em;color:#987951}
h1{font-size:clamp(46px,6vw,86px);font-weight:300;letter-spacing:-.06em;margin:12px 0 32px}
p{font:400 16px/1.9 Arial,sans-serif;white-space:pre-wrap}
a{text-decoration:underline;text-underline-offset:3px;color:inherit}
</style>
